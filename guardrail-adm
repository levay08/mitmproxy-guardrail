# gitsha1 is the hub blob name, where no sha256 pinned
file_digest() {
  case "$1" in
    sha256) sha256sum -- "$2" | cut -d' ' -f1 ;;
    gitsha1) { printf 'blob %s\0' "$(wc -c <"$2")"; cat -- "$2"; } | sha1sum | cut -d' ' -f1 ;;
    *) return 1 ;;
  esac
}

# all pinned files present and matching; BAD names first failure
model_check() {
  local root="$1" repo commit file alg want f got
  while read -r repo commit file alg want; do
    f="$root/hub/models--${repo//\//--}/snapshots/$commit/$file"
    [ -f "$f" ] && [ ! -L "$f" ] || { BAD="model file missing: $f"; return 1; }
    got="$(file_digest "$alg" "$f")"
    [ "$got" = "$want" ] || { BAD="$f fails its pin ($alg expected $want, got ${got:-none})"; return 1; }
  done < <(model_manifest)
}

# stage owner's cache as root; one bad pin installs nothing
install_model() {
  local src="$1" stage="$LIBDIR/hf.new" repo commit file alg want d dest
  if [ -z "$src" ]; then say "model: no owner cache path known; model layer not installed"; return 1; fi
  rm -rf "$stage"
  install -d -m 0755 "$stage/hub" || return 1
  while read -r repo commit file alg want; do
    d="models--${repo//\//--}"
    dest="$stage/hub/$d/snapshots/$commit/$file"
    install -d -m 0755 "${dest%/*}" "$stage/hub/$d/refs"
    printf '%s' "$commit" >"$stage/hub/$d/refs/main"
    # root never opens the owner's path; the owner's cat does
    if ! as_owner cat -- "$src/$d/snapshots/$commit/$file" >"$dest" 2>/dev/null </dev/null; then
      rm -rf "$stage"; say "model: $d/snapshots/$commit/$file not readable in $src; model layer not installed"
      return 1
    fi
  done < <(model_manifest)
  chown -hR root:root "$stage"
  chmod -R a+rX,go-w "$stage"
  if ! model_check "$stage"; then
    rm -rf "$stage"; say "model: CHECKSUM FAILURE, nothing installed: $BAD"
    return 1
  fi
  tree_ok "$stage" || { rm -rf "$stage"; say "model: staged tree refused: $BAD"; return 1; }
  rm -rf "$HFDIR.old"
  [ -d "$HFDIR" ] && mv "$HFDIR" "$HFDIR.old"
  mv "$stage" "$HFDIR" && rm -rf "$HFDIR.old"
  say "model layer installed in $HFDIR ($(du -sh "$HFDIR" | cut -f1)), every file matches its pin"
}

make_dirs() {
  local d
  [ -n "$OWNER_GROUP" ] || die "owner group unknown; cannot set the audit directory group"
  for d in "$VARDIR" "$CONFDIR" "$STATE" "$STATE/data" "$LOGDIR"; do
    [ -L "$d" ] && die "$d is a symlink; refused"
  done
  install -d -o root -g root -m 0755 "$VARDIR"
  install -d -o "$PUSER" -g "$(id -gn "$PUSER")" -m 0700 "$CONFDIR"
  install -d -o "$PUSER" -g "$(id -gn "$PUSER")" -m 0750 "$STATE"
  # audit dir: proxy owns it, the owner's group reads it
  install -d -o "$PUSER" -g "$OWNER_GROUP" -m 2750 "$LOGDIR"
  # PAC is read by the owner's session, so 0755
  install -d -o "$PUSER" -g "$(id -gn "$PUSER")" -m 0755 "$PACDIR"
  as_puser mkdir -p "$STATE/data"
  # notify writes <GUARDRAIL_HOME>/logs, which lands in $LOGDIR
  if [ ! -e "$STATE/logs" ] || [ -L "$STATE/logs" ]; then as_puser ln -sfn "$LOGDIR" "$STATE/logs"; fi
  add_audit_file
}

# create the audit file so appends keep its mode
add_audit_file() {
  local f="$LOGDIR/audit.jsonl"
  [ -L "$f" ] && { say "audit file is a symlink; left alone: $f"; return 0; }
  if [ ! -e "$f" ]; then
    as_puser /bin/sh -c 'umask 027; : >"$0"' "$f" || { say "could not create $f"; return 0; }
  fi
  chown "$PUSER:$OWNER_GROUP" "$f" 2>/dev/null
  chmod 0640 "$f" 2>/dev/null
  say "audit file: $(describe "$f")"
}

LOGROTATE_FILE=/etc/logrotate.d/guardrail

# audit: rename+create, nothing lost, never deleted
logrotate_text() {
  cat <<EOF
# Written by guardrail-adm install. Removed by uninstall.
# audit.jsonl: the proxy reopens it per write, so rename is lossless.
# rotate 1200 keeps every file for years; compressed it is tiny.
$LOGDIR/audit.jsonl {
    su $PUSER $OWNER_GROUP
    monthly
    maxsize 50M
    rotate 1200
    dateext
    dateformat -%Y%m%d-%s
    compress
    delaycompress
    missingok
    notifempty
    create 0640 $PUSER $OWNER_GROUP
    postrotate
        chmod 0640 $LOGDIR/audit.jsonl 2>/dev/null || true
    endscript
}

# detector-metrics.jsonl: reopened per write too, rename is safe.
$LOGDIR/detector-metrics.jsonl {
    su $PUSER $OWNER_GROUP
    weekly
    maxsize 10M
    rotate 12
    dateext
    dateformat -%Y%m%d-%s
    compress
    delaycompress
    missingok
    notifempty
    create 0600 $PUSER $PUSER
}

# proxy.log: the shell holds it open, so copy then truncate.
# Lines written inside that window are lost; audit.jsonl holds decisions.
$LOGDIR/proxy.log {
    su $PUSER $OWNER_GROUP
    daily
    maxsize 20M
    rotate 14
    dateext
    dateformat -%Y%m%d-%s
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
}
EOF
}

logrotate_install() {
  [ "$DEV" = 1 ] && return 0
  [ -d /etc/logrotate.d ] || { say "no /etc/logrotate.d; log rotation not installed"; return 0; }
  local tmp
  tmp="$(mktemp)" || return 0
  logrotate_text >"$tmp"
  install -o root -g root -m 0644 "$tmp" "$LOGROTATE_FILE" \
    && say "log rotation: $LOGROTATE_FILE (audit kept, proxy.log capped)"
  rm -f "$tmp"
}

# no CA anywhere: ask mitmdump to make one
create_ca() {
  local dur=0 pid
  say "no CA yet: asking mitmdump to create one in $CONFDIR"
  as_puser env HOME="$STATE" "$VENV/bin/mitmdump" --set confdir="$CONFDIR" \
    --mode regular --listen-port 8895 -q >/dev/null 2>&1 &
  pid=$!
  while [ "$dur" -lt 40 ]; do
    as_puser test -s "$CONFDIR/mitmproxy-ca.pem" && break
    sleep 0.5; dur=$((dur + 1))
  done
  kill "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  # runuser forks mitmdump: kill the real 8895 process
  pkill -u "$PUSER" -f 'mitmdump.*--listen-port 8895' 2>/dev/null || true
}

# copy CA files to $CONFDIR, written by the proxy user
copy_ca_files() {
  local tmp="$1" f
  for f in $CA_FILES; do
    [ "$f" = mitmproxy-ca.pem ] || as_owner cat "$USER_HOME/.mitmproxy/$f" >"$tmp/$f" 2>/dev/null || { rm -f "$tmp/$f"; continue; }
    # proxy user writes it; root never opens that path
    as_puser /bin/sh -c 'umask 077; cat >"$0"' "$CONFDIR/$f" <"$tmp/$f" || { rm -rf "$tmp"; die "writing $CONFDIR/$f failed"; }
  done
}

# publish cert and prove key, cert, source share one identity
publish_ca() {
  local src_fp="$1" tmp cert_fp_pub
  tmp="$(mktemp)"
  as_puser cat "$CONFDIR/mitmproxy-ca-cert.pem" >"$tmp" 2>/dev/null || as_puser cat "$CONFDIR/mitmproxy-ca.pem" \
    | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' >"$tmp"
  cert_fp_pub="$(cert_fp <"$tmp")"
  CA_FP="$(as_puser cat "$CONFDIR/mitmproxy-ca.pem" | cert_fp)"
  [ -n "$CA_FP" ] && [ "$cert_fp_pub" = "$CA_FP" ] || { rm -f "$tmp"; die "the CA certificate ($cert_fp_pub) does not match the CA key file ($CA_FP)"; }
  [ -z "$src_fp" ] || [ "$src_fp" = "$CA_FP" ] || { rm -f "$tmp"; die "fingerprint changed during copy: $src_fp -> $CA_FP"; }
  install -d -o root -g root -m 0755 "$LIBDIR"
  install -o root -g root -m 0644 "$tmp" "$CA_PUB"
  rm -f "$tmp"
  say "CA fingerprint sha256 $CA_FP (source ${src_fp:-not present}, $CONFDIR, $CA_PUB: same)"
}

# copy the owner's CA to $CONFDIR, or create one
install_ca() {
  local tmp src_fp dst_fp
  tmp="$(mktemp -d)" || die "mktemp failed"
  if as_owner cat "$USER_HOME/.mitmproxy/mitmproxy-ca.pem" >"$tmp/mitmproxy-ca.pem" 2>/dev/null; then
    src_fp="$(cert_fp <"$tmp/mitmproxy-ca.pem")"
  else
    src_fp=""
  fi
  dst_fp="$(as_puser cat "$CONFDIR/mitmproxy-ca.pem" 2>/dev/null | cert_fp)"
  if [ -z "$src_fp" ] && [ -z "$dst_fp" ]; then
    # no CA anywhere: let mitmdump create one, do not fail
    create_ca
    dst_fp="$(as_puser cat "$CONFDIR/mitmproxy-ca.pem" 2>/dev/null | cert_fp)"
    if [ -z "$dst_fp" ]; then
      rm -rf "$tmp"
      die "mitmdump did not create a CA in $CONFDIR within 20s; nothing installed"
    fi
    say "CA created by mitmdump in $CONFDIR"
  fi
  if [ -n "$dst_fp" ] && [ -n "$src_fp" ] && [ "$dst_fp" != "$src_fp" ]; then
    rm -rf "$tmp"
    die "$CONFDIR holds a different CA ($dst_fp) than $USER_HOME/.mitmproxy ($src_fp); a CA identity is not replaced. Run uninstall first if that is intended"
  fi
  if [ -n "$src_fp" ] && [ -z "$dst_fp" ]; then
    copy_ca_files "$tmp"
    say "CA copied from $USER_HOME/.mitmproxy to $CONFDIR"
  else
    say "CA already in $CONFDIR"
  fi
  rm -rf "$tmp"
  # The public certificate, for trust stores and NODE_EXTRA_CA_CERTS.
  publish_ca "$src_fp"
  # owner keeps their CA key; restrict it here, once
  tighten_owner_ca
}

install_trust() {
  local entry u d marker
  case "$GR_CA_METHOD" in
    anchor-dir)
      if cmp -s "$CA_PUB" "$GR_CA_ANCHOR"; then say "trust anchor $GR_CA_ANCHOR already current"
      else
        install -o root -g root -m 0644 "$CA_PUB" "$GR_CA_ANCHOR"
        "${GR_CA_UPDATE[@]}" >/dev/null 2>&1 && say "trust anchor $GR_CA_ANCHOR installed, ${GR_CA_UPDATE[*]} ran" \
          || say "WARNING: ${GR_CA_UPDATE[*]} failed; anchor written at $GR_CA_ANCHOR"
      fi
      record_add ANCHOR "$GR_CA_ANCHOR"
      record_add UPDATE "${GR_CA_UPDATE[*]}" ;;
    p11-kit)
      "$GR_CA_P11KIT" anchor --store "$CA_PUB" >/dev/null 2>&1 && say "trust anchor stored with p11-kit" \
        || say "WARNING: p11-kit trust anchor --store failed"
      record_add P11KIT "$GR_CA_P11KIT" ;;
    *) say "skipped system trust: ${GR_CA_SKIP:-unknown CA store}" ;;
  esac
  if [ -n "$GR_CA_BUNDLE" ]; then
    marker="$(sed -n 2p "$CA_PUB")"
    grep -qF "$marker" "$GR_CA_BUNDLE" && say "system bundle $GR_CA_BUNDLE carries the CA" \
      || say "WARNING: system bundle $GR_CA_BUNDLE does not carry the CA yet"
  fi
  # each NSS store written by the account that owns it
  if [ -z "$GR_CERTUTIL" ]; then
    say "skipped NSS stores: certutil not found (${#GR_NSS_DBS[@]} store(s) seen)"
  else
    for entry in "${GR_NSS_DBS[@]}"; do
      u="${entry%%:*}"; d="${entry#*:}"
      if as_user "$u" "$GR_CERTUTIL" -d "sql:$d" -A -n guardrail -t "C,," -i "$CA_PUB" 2>/dev/null; then
        say "NSS: guardrail CA in $d ($u)"; record_add NSS "$entry"
      else
        say "WARNING: NSS store $d ($u) not updated"
      fi
    done
    [ "${#GR_NSS_DBS[@]}" -gt 0 ] || say "no NSS stores found"
  fi
  # runtimes ignoring the system store read these at login
  case "$GR_ENV_METHOD" in
    environment.d)
      install -d -o root -g root -m 0755 "$(dirname "$GR_ENV_FILE")"
      {
        echo "# Guardrail CA, written by guardrail-adm install."
        [ -n "$GR_CA_BUNDLE" ] && printf 'SSL_CERT_FILE=%s\nREQUESTS_CA_BUNDLE=%s\nCURL_CA_BUNDLE=%s\n' "$GR_CA_BUNDLE" "$GR_CA_BUNDLE" "$GR_CA_BUNDLE"
        printf 'NODE_EXTRA_CA_CERTS=%s\n' "$CA_PUB"
      } >"$GR_ENV_FILE"
      chmod 0644 "$GR_ENV_FILE"; record_add ENVFILE "$GR_ENV_FILE"
      say "CA variables in $GR_ENV_FILE (read at the next login)" ;;
    profile.d)
      {
        echo "# Guardrail CA, written by guardrail-adm install."
        [ -n "$GR_CA_BUNDLE" ] && printf 'export SSL_CERT_FILE=%q REQUESTS_CA_BUNDLE=%q CURL_CA_BUNDLE=%q\n' "$GR_CA_BUNDLE" "$GR_CA_BUNDLE" "$GR_CA_BUNDLE"
        printf 'export NODE_EXTRA_CA_CERTS=%q\n' "$CA_PUB"
      } >"$GR_ENV_FILE"
      chmod 0644 "$GR_ENV_FILE"; record_add ENVFILE "$GR_ENV_FILE"
      say "CA variables in $GR_ENV_FILE (read by login shells)" ;;
    *) say "skipped CA variables: ${GR_ENV_SKIP:-no place for them}" ;;
  esac
}

dry_run_report() {
  # prints this device's plan from the install values; changes nothing
  local plan with_model="$1" persist="$2" enable_units="$3" dur="$4" evaluated=0
  # the owner's copy is never evaluated as root
  GR_DISTRO_NAME="" GR_DISTRO_ID="" GR_DISTRO_LIKE="" GR_INIT=""
  GR_CA_METHOD="" GR_CA_ANCHOR="" GR_CA_BUNDLE="" GR_ENV_FILE="" GR_ENV_METHOD=""
  GR_NSS_DBS=()
  say "== install plan for this machine (nothing is changed) =="
  # Only a root-owned copy is evaluated as root
  if [ "$(id -u)" != 0 ]; then
    plan="$(python3 -I "$APP/rules.py" plan 2>/dev/null)"
    [ -n "$plan" ] && eval "$plan" && evaluated=1
  elif [ -f "$IAPP/rules.py" ] && tree_ok "$IAPP"; then
    plan="$(SUDO_UID="$UID_TARGET" python3 -I "$IAPP/rules.py" plan 2>/dev/null)"
    [ -n "$plan" ] && eval "$plan" && evaluated=1
  else
    # The project tree is the owner's: lines shown, never evaluated
    plan="$(as_owner python3 -I "$APP/rules.py" plan 2>/dev/null)"
    if [ -n "$plan" ]; then
      say "plan from the project copy (shown, not evaluated as root):"
      printf '%s\n' "$plan" | sed 's/^/  /'
    fi
  fi
  if [ "$evaluated" = 1 ]; then
    say "host       : $GR_DISTRO_NAME (id $GR_DISTRO_ID${GR_DISTRO_LIKE:+, like $GR_DISTRO_LIKE}), init $GR_INIT"
    say "CA         : method ${GR_CA_METHOD:-unclear}${GR_CA_ANCHOR:+, anchor $GR_CA_ANCHOR}"
    say "CA bundle  : ${GR_CA_BUNDLE:-not found}"
    say "NSS        : ${#GR_NSS_DBS[@]} browser store(s) found"
    say "CA vars    : ${GR_ENV_FILE:-no place}${GR_ENV_METHOD:+ (via $GR_ENV_METHOD)}"
  elif [ -n "$plan" ]; then
    say "host       : not evaluated (the copy in the project tree belongs to you)"
  else
    say "host       : rules.py plan could not run; the rest of the plan is still shown"
  fi
  say "account    : owner $OWNER (uid $UID_TARGET), proxy user $PUSER"
  say "root venv  : $VENV (built from the project venv pins; needs network once)"
  say "app        : root-owned copy at $IAPP"
  say "state dirs : $CONFDIR, $STATE, $PACDIR (owned by $PUSER, proxy-only)"
  say "audit dir  : $LOGDIR (owner $PUSER, group $OWNER_GROUP, mode 2750, group reads it)"
  say "helper     : $SELF (already present here)"
  say "unit       : guardrail-proxy.service, guardrail-sync.timer, guardrail-net.service"
  if [ "$enable_units" = 1 ]; then
    say "            will be ENABLED, so it starts by itself on every boot"
  else
    say "            written but NOT enabled; nothing starts by itself after a boot"
  fi
  if [ "$do_arm" = 1 ]; then
    say "rule       : will be INSTALLED now, port $PORT, failsafe $dur, persist=$([ "$persist" = 1 ] && echo yes || echo no)"
    say "            then checked end to end; if that fails the rule removes itself"
  else
    say "rule       : NOT installed (default); your traffic is not diverted until you run arm"
  fi
  say "CA         : $([ -f "$USER_HOME/.mitmproxy/mitmproxy-ca.pem" ] && echo "copied from $USER_HOME/.mitmproxy" || echo "created new by mitmdump in $CONFDIR")"
  [ "$with_model" = 1 ] && say "option     : the language-model layer is installed too; weights are copied from ${MODEL_SRC:-$USER_HOME/.cache/huggingface/hub} into $HFDIR if they match their pinned sha256"
  say ""
  say "after the real install, run:"
  say "  bash $APP/run.sh verify"
  say "  sudo /usr/local/sbin/guardrail-adm verify"
  say "  sudo /usr/local/sbin/guardrail-adm status"
}


# payload: dirs, app copy, plan, venv, CA, trust
install_payload() {
  local with_model="$1"
  make_dirs
  logrotate_install
  copy_app
  load_plan
  build_venv "$with_model"
  # no model degrades the proxy; install goes on
  if [ "$with_model" = 1 ]; then
    install_model "${MODEL_SRC:-$USER_HOME/.cache/huggingface/hub}" \
      || say "WARNING: no model layer; free-form names that escape the regex rules pass unmasked"
  fi
  install_ca
  install_trust
}

# an earlier proxy, root or run.sh, gets replaced
install_swap_proxy() {
  proxy_up || return 0
  case " $(listener_users) " in
    *" $PUSER "*) [ "${APP_CHANGED:-0}${VENV_CHANGED:-0}" = 00 ] || proxy_stop ;;
    *) say "stopping the proxy on $PORT run as: $(listener_users)"; proxy_stop ;;
  esac
}

# write units or a runner; boot start is never automatic
install_boot_units() {
  local enable_units="$1"
  if [ "$HAS_SYSTEMD" = 1 ]; then
    ensure_table
    units_install
    systemctl start guardrail-sync.timer
    if [ "$enable_units" = 1 ]; then
      if systemctl enable guardrail-proxy.service guardrail-sync.timer >/dev/null 2>&1; then
        say "units enabled: the proxy and the sync timer start at boot"
      else
        say "WARNING: could not enable the units; start them by hand after a reboot"
      fi
    else
      say "units written but not enabled: nothing starts at boot"
      say "  make them permanent with: sudo $SELF units-enable"
    fi
  else
    pin_owner
    write_runner
    say "no systemd ($GR_INIT): the proxy starts now through runuser/setpriv and does not return after a reboot"
  fi
}

install_all() {
  local with_model=1 persist=0 enable_units=0 dry=0 do_arm=0 dur=15m a
  for a in "$@"; do
    case "$a" in
      --with-model) with_model=1 ;;
      --model-src=*) MODEL_SRC="${a#--model-src=}" ;;
      --no-deps) NO_DEPS=1 ;;
      --persist) persist=1 ;;
      --enable-units) enable_units=1 ;;
      --dry-run) dry=1 ;;
      --arm) do_arm=1 ;;
      --failsafe=*) dur="${a#--failsafe=}" ;;
      *) die "install: unknown option $a" ;;
    esac
  done
  [ "$DEV" = 1 ] && die "install never runs in --dev mode"
  [ "$do_arm" != 1 ] || arm_window_ok "$dur"
  install_deps "$dry" || die "prerequisites are incomplete; install them and run install again"
  need_sudo_tool; need_app; need_nft; need_python
  command -v ss >/dev/null 2>&1 || die "ss not found: install iproute2"
  [ "$(failsafe_method)" != none ] || die "no systemd and no setsid/sleep: the rule could not remove itself; nothing installed"
  if [ "$dry" = 1 ]; then dry_run_report "$with_model" "$persist" "$enable_units" "$dur"; exit 0; fi
  say "== install for owner $OWNER (uid $UID_TARGET), source $APP"
  need_puser
  install -d -o root -g root -m 0755 /etc/guardrail
  : >"$RECORD.new"
  chmod 0644 "$RECORD.new"
  record_add OWNER_UID "$UID_TARGET"
  install_payload "$with_model"
  install_swap_proxy
  install_boot_units "$enable_units"
  proxy_start
  if [ "$do_arm" = 1 ]; then
    arm "$dur"
  else
    say "rule NOT armed: nothing of yours is diverted yet"
    say "  arm it when you are ready: sudo $SELF arm $dur"
    say "  note: clients that were already running may not trust the CA until you log out and back in"
  fi
  if [ "$do_arm" = 1 ] && [ "$persist" = 1 ] && [ "$HAS_SYSTEMD" = 1 ]; then
    # never save an empty ruleset over a good one
    if $NFT list table inet guardrail >/etc/guardrail/guardrail.nft.new 2>/dev/null \
       && [ -s /etc/guardrail/guardrail.nft.new ]; then
      mv -f /etc/guardrail/guardrail.nft.new /etc/guardrail/guardrail.nft
    else
      rm -f /etc/guardrail/guardrail.nft.new
      say "WARNING: the ruleset could not be saved; guardrail-net.service has nothing to load"
    fi
    # A persisted rule needs the listener it points at
    if systemctl enable guardrail-proxy.service guardrail-sync.timer guardrail-net.service >/dev/null 2>&1
    then
      say "rule persisted: guardrail-net.service, the proxy and the sync timer start at boot"
      say "  note: the armed failsafe still releases the rule in this session after $dur"
      say "  note: after a reboot the rule is installed again, with no dead-man switch"
    else
      say "rule NOT persisted: the units could not be enabled; run: sudo $SELF units-enable"
    fi
  else
    say "rule not persisted: it lives until the failsafe fires in $dur (use --persist to keep it)"
  fi
  mv -f "$RECORD.new" "$RECORD"; chmod 0644 "$RECORD"
  echo
  if [ "$do_arm" = 1 ]; then
    verify
  else
    say "install complete; the rule is not armed (arm it with: sudo $SELF arm)"
    say "check the install read-only: bash $APP/run.sh verify"
  fi
}

yaml_loader_line() {
  # prints the loader line; fallback warns, never fails
  case "$1" in
    CSafeLoader) printf '  yaml loader        : CSafeLoader\n' ;;
    *) printf '  NOTE  yaml loader : %s (pure-Python fallback; loading the rules is about six times slower, measured 6.1 s against 1.0 s on 825 files; the rules loaded are the same)\n' "$1" ;;
  esac
}

verify() {
  local fail=0 p fp_conf fp_cert fp_pub fp_anchor fp_src rules ru=0 tbl
  ok() { printf '  OK    %s\n' "$*"; }
  bad() { printf '  FAIL  %s\n' "$*"; fail=1; }
  note() { printf '  NOTE  %s\n' "$*"; }
  echo "== verify"
  if puser_exists; then ok "user: $(id "$PUSER"), shell $(getent passwd "$PUSER" | cut -d: -f7)"
  else bad "user $PUSER missing"; fi
  # venv python runs as root only after tree_ok passed
  if [ ! -x "$VENV/bin/python" ]; then bad "venv $VENV missing"
  elif ! tree_ok "$VENV" 1; then bad "venv not run: $BAD"
  else
    ok "venv: $("$VENV/bin/python" -I -c 'import importlib.metadata as m, sys; print("python", sys.version.split()[0], "mitmproxy", m.version("mitmproxy"))' 2>&1)"
    yaml_loader_line "$("$VENV/bin/python" -I -c 'import yaml; print(getattr(yaml, "CSafeLoader", yaml.SafeLoader).__name__)' 2>&1)"
    if "$VENV/bin/python" -I -c 'import importlib.util as u, sys; sys.exit(0 if u.find_spec("gliner") else 1)' 2>/dev/null; then
      if [ ! -d "$HFDIR" ]; then bad "model layer: gliner is installed but $HFDIR is missing, so free-form names pass unmasked"
      elif ! tree_ok "$HFDIR"; then bad "model layer: $BAD"
      elif model_check "$HFDIR"; then ok "model weights match their pinned checksums: $(describe "$HFDIR")"
      else bad "model layer: $BAD"; fi
    else note "model layer not installed (install --with-model); free-form names are not masked"; fi
  fi
  for p in "$LIBDIR" "$VENV" "$IAPP" "$RUNNER" "$CA_PUB"; do
    # the venv lives inside LIBDIR and always holds links
    case "$p" in "$VENV"|"$LIBDIR") links=1 ;; *) links=0 ;; esac
    if [ -d "$p" ]; then tree_ok "$p" "$links" \
      && ok "root-only: $(describe "$p")" || bad "$BAD"
    elif [ -e "$p" ]; then chain_ok "$p" && ok "root-only: $(describe "$p")" || bad "$BAD"
    else bad "$p missing"; fi
  done
  puser_dir_ok "$CONFDIR" 700 && ok "proxy-only: $(describe "$CONFDIR")" || bad "$BAD"
  puser_dir_ok "$STATE" 750 && ok "proxy-only: $(describe "$STATE")" || bad "$BAD"
  audit_dir_ok && ok "audit dir: $(describe "$LOGDIR")" || bad "$BAD"
  if [ -f "$LOGDIR/audit.jsonl" ]; then
    if [ "$(stat -c '%G %a' "$LOGDIR/audit.jsonl")" = "$OWNER_GROUP 640" ]; then
      ok "audit file: $(describe "$LOGDIR/audit.jsonl")"
    else
      bad "$(describe "$LOGDIR/audit.jsonl"), expected group $OWNER_GROUP mode 640"
    fi
  else bad "$LOGDIR/audit.jsonl missing"; fi
  fp_conf="$(as_puser cat "$CONFDIR/mitmproxy-ca.pem" 2>/dev/null | cert_fp)"
  fp_cert="$(as_puser cat "$CONFDIR/mitmproxy-ca-cert.pem" 2>/dev/null | cert_fp)"
  fp_pub="$(cert_fp <"$CA_PUB" 2>/dev/null)"
  fp_anchor="$(p="$(rec_get ANCHOR | tail -1)"; [ -n "$p" ] && cert_fp <"$p" 2>/dev/null)"
  fp_src="$([ -n "$OWNER" ] && as_owner cat "$USER_HOME/.mitmproxy/mitmproxy-ca.pem" 2>/dev/null | cert_fp)"
  echo "  CA sha256 key file : ${fp_conf:-none}"
  echo "  CA sha256 cert     : ${fp_cert:-none}"
  echo "  CA sha256 public   : ${fp_pub:-none}"
  echo "  CA sha256 anchor   : ${fp_anchor:-none}"
  echo "  CA sha256 source   : ${fp_src:-none} ($USER_HOME/.mitmproxy)"
  if [ -n "$fp_conf" ] && [ "$fp_conf" = "$fp_pub" ] && { [ -z "$fp_cert" ] || [ "$fp_cert" = "$fp_conf" ]; } \
     && { [ -z "$fp_anchor" ] || [ "$fp_anchor" = "$fp_conf" ]; } && { [ -z "$fp_src" ] || [ "$fp_src" = "$fp_conf" ]; }; then
    ok "one CA identity everywhere it is present"
  else bad "CA fingerprints differ or the CA is missing"; fi
  case "$(proxy_listeners)" in
    1:1) ok "listeners IPv4 and IPv6 on $PORT, as: $(listener_users)" ;;
    0:0) bad "listeners IPv4:IPv6 = 0:0 on $PORT: the proxy is not running; 'guardrail-adm proxy-start' starts it" ;;
    *) bad "listeners IPv4:IPv6 = $(proxy_listeners) on $PORT" ;;
  esac
  listener_is_root "$(listener_users)" && bad "a listener on $PORT runs as root"
  if [ -n "$NFT" ]; then
    if tbl="$($NFT list table inet guardrail 2>/dev/null)"; then
      rules="$(grep -cE 'redirect to|udp dport 443 .* (drop|reject)' <<<"$tbl")"
    elif nft_absent; then rules=0
    else rules=0; ru=1
    fi
    if [ "$ru" = 1 ]; then bad "rule state unknown: nft could not be read, so diversion is neither confirmed nor ruled out"
    elif [ "${rules:-0}" -ge 4 ]; then ok "rule: $rules redirect/reject lines in inet guardrail"
    elif [ "${rules:-0}" = 0 ]; then note "rule not installed: nothing is diverted yet (arm it: sudo $SELF arm 15m)"
    else bad "rule: ${rules:-0} redirect/reject lines (expected 4)"
    fi
  else bad "nft missing"; fi
  if [ "$HAS_SYSTEMD" = 1 ]; then
    systemctl list-timers --all 'guardrail*' --no-pager 2>&1 | sed -n '1,4p' | sed 's/^/  /'
    if systemctl is-active --quiet "$UNIT.timer"; then ok "failsafe timer active"
    elif [ "$ru" = 0 ] && [ "${rules:-0}" = 0 ]; then note "no failsafe timer while nothing is diverted"
    else bad "failsafe timer not active"
    fi
    echo "  units: proxy $(systemctl is-enabled guardrail-proxy.service 2>&1)/$(systemctl is-active guardrail-proxy.service 2>&1), sync timer $(systemctl is-enabled guardrail-sync.timer 2>&1), net $(systemctl is-enabled guardrail-net.service 2>&1)"
  elif [ -f "$FSPID" ] && kill -0 "$(cat "$FSPID")" 2>/dev/null; then ok "background failsafe pid $(cat "$FSPID")"
  else bad "no failsafe armed"; fi
  # only check owner request when a rule is installed
  if [ "$ru" = 1 ]; then
    say "  note: rule state unknown, so the owner-request check was not run"
  elif [ -n "$NFT" ] && [ "${rules:-0}" -ge 4 ]; then
    if e2e_check; then ok "owner request through the guardrail: reached the provider and was recorded"
    else bad "owner request through the guardrail failed; consider: $SELF disarm"
    fi
  else
    say "  note: no redirect rule installed, so the owner-request check is skipped (nothing is diverted)"
  fi
  [ "$fail" = 0 ] && say "verify: all checks passed" || say "verify: FAILED (see FAIL lines)"
  return "$fail"
}

uninstall() {
  local l u d upd=()
  [ "$DEV" = 1 ] && die "uninstall never runs in --dev mode"
  if [ -n "$NFT" ]; then
    $NFT delete table inet guardrail 2>/dev/null && say "table inet guardrail deleted"
    # a standing rule keeps its failsafe and proxy
    if $NFT list table inet guardrail >/dev/null 2>&1; then
      die "the nft table could not be deleted; failsafe and proxy are left running"
    fi
  fi
  failsafe_cancel
  proxy_stop
  rm -f "$LOGROTATE_FILE"
  units_remove
  rm -f "$UNITDIR/$UNIT.service" "$UNITDIR/$UNIT.timer"
  [ "$HAS_SYSTEMD" = 1 ] && systemctl daemon-reload
  # undo what install recorded, including half-done runs
  read -ra upd <<<"$(rec_get UPDATE | tail -1)"
  while IFS= read -r l; do
    if [ -f "$l" ] && { [ ! -f "$CA_PUB" ] || cmp -s "$l" "$CA_PUB"; }; then rm -f "$l"; say "trust anchor $l removed"
      [ "${#upd[@]}" -gt 0 ] && "${upd[@]}" >/dev/null 2>&1 && say "${upd[*]} ran"
    fi
  done < <(rec_get ANCHOR)
  while IFS= read -r l; do
    [ -f "$CA_PUB" ] && "$l" anchor --remove "$CA_PUB" >/dev/null 2>&1 && say "p11-kit anchor removed"
  done < <(rec_get P11KIT)
  while IFS= read -r l; do
    u="${l%%:*}"; d="${l#*:}"
    id "$u" >/dev/null 2>&1 && command -v certutil >/dev/null 2>&1 \
      && as_user "$u" certutil -d "sql:$d" -D -n guardrail 2>/dev/null && say "NSS: guardrail removed from $d ($u)"
  done < <(rec_get NSS)
  while IFS= read -r l; do
    case "$l" in /etc/environment.d/*guardrail*|/etc/profile.d/*guardrail*) rm -f "$l" && say "removed $l" ;; esac
  done < <(rec_get ENVFILE)
  if [ "${KEEP_AUDIT:-0}" = 1 ]; then
    rm -rf "$LIBDIR" "$VARDIR" && say "removed $LIBDIR $VARDIR; $LOGDIR kept"
  else
    rm -rf "$LIBDIR" "$VARDIR" "$LOGDIR" && say "removed $LIBDIR $VARDIR $LOGDIR"
  fi
  if puser_exists; then
    pkill -u "$PUSER" 2>/dev/null; sleep 0.5; pkill -9 -u "$PUSER" 2>/dev/null
    { userdel "$PUSER" 2>/dev/null || deluser "$PUSER" 2>/dev/null; } && say "$PUSER removed"
    getent group "$PUSER" >/dev/null 2>&1 && { groupdel "$PUSER" 2>/dev/null || delgroup "$PUSER" 2>/dev/null; }
  fi
  rm -f "$RECORD" "$RECORD.new" "$PIDFILE"
  say "uninstall done; the helper, the sudoers entry, /etc/guardrail and $USER_HOME/.mitmproxy are left (revoke removes the helper)"
}

# the app copy before the last changing install
app_prev_ok() { [ -f "$IAPP.prev/guardrail.py" ] && tree_ok "$IAPP.prev"; }

rollback() {
  local was_up=0 stamp
  if app_prev_ok; then
    # logs, venv and CA stay
    disarm
    proxy_up && was_up=1
    proxy_stop
    stamp="$(date +%Y%m%d-%H%M%S)"
    mv "$IAPP" "$IAPP.rolled-$stamp"
    mv "$IAPP.prev" "$IAPP"
    if ! tree_ok "$IAPP"; then
      rm -rf "$IAPP"; mv "$IAPP.rolled-$stamp" "$IAPP"
      die "the previous app failed its own check: $BAD; the current app is back"
    fi
    mv "$IAPP.rolled-$stamp" "$IAPP.prev"
    say "rollback: app restored from $IAPP.prev; $LOGDIR left alone"
    if [ "$was_up" = 1 ]; then proxy_start "$PUSER"; else say "the proxy was not running; start it with: sudo $SELF proxy-start"; fi
    return 0
  fi
  if [ -d "$LIBDIR" ] || [ -d "$VARDIR" ] || [ -f "$RECORD" ]; then
    say "rollback: no previous app copy, so this removes the install; the audit log is kept"
    KEEP_AUDIT=1 uninstall
  else
    disarm
    proxy_stop
    units_remove
    [ -n "$NFT" ] && $NFT delete table inet guardrail 2>/dev/null && say "table inet guardrail deleted"
    rm -f "$UNITDIR/$UNIT.service" "$UNITDIR/$UNIT.timer"
    [ "$HAS_SYSTEMD" = 1 ] && systemctl daemon-reload
    { userdel "$PUSER" 2>/dev/null || deluser "$PUSER" 2>/dev/null; } && say "$PUSER removed"
  fi
  rm -rf /etc/guardrail
  say "rollback done; the CA anchor, NSS entry and environment.d from phase 3 are left alone"
}

# ---- CA trust on its own: check, place again, remove -------------------------------------------

# stop unless install has placed the public CA
ca_need_pub() {
  [ -f "$CA_PUB" ] || die "no CA certificate at $CA_PUB yet; install first: sudo bash <tree>/guardrail-adm install"
}

# read-only; fails when no system store trusts the CA
ca_status() {
  local fp trusted=0 entry u d marker bundle_has
  ca_need_pub
  load_plan
  fp="$(cert_fp <"$CA_PUB")"
  bundle_has=1
  # anchor-dir file counts only once the bundle has it
  [ -n "$GR_CA_BUNDLE" ] && ! grep -qF "$(sed -n 2p "$CA_PUB")" "$GR_CA_BUNDLE" && bundle_has=0
  say "CA certificate : $CA_PUB (public part, copy this one to other machines)"
  say "CA private key : $CONFDIR (account $PUSER only, never copied)"
  say "CA sha256      : $fp"
  case "$GR_CA_METHOD" in
    anchor-dir)
      if [ ! -f "$GR_CA_ANCHOR" ]; then say "system anchor  : ABSENT ($GR_CA_ANCHOR)"
      elif cmp -s "$CA_PUB" "$GR_CA_ANCHOR"; then
        if [ "$bundle_has" = 1 ]; then say "system anchor  : trusted ($GR_CA_ANCHOR)"; trusted=1
        else say "system anchor  : file present, bundle not rebuilt (run ca-trust)"; fi
      else say "system anchor  : DIFFERENT certificate at $GR_CA_ANCHOR"; fi ;;
    p11-kit)
      if "$GR_CA_P11KIT" list 2>/dev/null | grep -qi 'label: mitmproxy'; then
        say "system anchor  : trusted (p11-kit)"; trusted=1
      else say "system anchor  : ABSENT (p11-kit)"; fi ;;
    *) say "system anchor  : no store known here (${GR_CA_SKIP:-unknown})" ;;
  esac
  if [ -n "$GR_CA_BUNDLE" ]; then
    marker="$(sed -n 2p "$CA_PUB")"
    if grep -qF "$marker" "$GR_CA_BUNDLE"; then say "system bundle  : carries the CA ($GR_CA_BUNDLE)"; trusted=1
    else say "system bundle  : does not carry the CA ($GR_CA_BUNDLE)"; fi
  fi
  if [ -z "$GR_CERTUTIL" ]; then say "browser stores : certutil not found, cannot read NSS stores"
  else
    for entry in "${GR_NSS_DBS[@]}"; do
      u="${entry%%:*}"; d="${entry#*:}"
      if as_user "$u" "$GR_CERTUTIL" -d "sql:$d" -L -n guardrail >/dev/null 2>&1; then say "browser store  : trusted in $d ($u)"
      else say "browser store  : ABSENT in $d ($u)"; fi
    done
    [ "${#GR_NSS_DBS[@]}" -gt 0 ] || say "browser stores : none found (open the browser once, then re-run)"
  fi
  if [ -n "$GR_ENV_FILE" ] && [ -f "$GR_ENV_FILE" ] && grep -q NODE_EXTRA_CA_CERTS "$GR_ENV_FILE"; then
    say "runtime vars   : $GR_ENV_FILE"
  else say "runtime vars   : ABSENT (${GR_ENV_FILE:-no place})"; fi
  [ "$trusted" = 1 ]
}

# place the trust again; nothing else changes
ca_trust() {
  ca_need_pub
  load_plan
  # keep what an earlier install recorded
  install -d -o root -g root -m 0755 "$(dirname "$RECORD")"
  if [ -f "$RECORD" ]; then cp -p "$RECORD" "$RECORD.new"; else : >"$RECORD.new"; fi
  chmod 0644 "$RECORD.new"
  install_trust
  awk '!seen[$0]++' "$RECORD.new" >"$RECORD.tmp" && mv -f "$RECORD.tmp" "$RECORD" && rm -f "$RECORD.new"
  chmod 0644 "$RECORD"
  ca_status
}

# remove trust from recorded stores; install stays
ca_untrust() {
  local l u d upd=() n=0
  read -ra upd <<<"$(rec_get UPDATE | tail -1)"
  while IFS= read -r l; do
    if [ -f "$l" ] && { [ ! -f "$CA_PUB" ] || cmp -s "$l" "$CA_PUB"; }; then
      rm -f "$l"; say "trust anchor $l removed"; n=$((n + 1))
      [ "${#upd[@]}" -gt 0 ] && "${upd[@]}" >/dev/null 2>&1 && say "${upd[*]} ran"
    fi
  done < <(rec_get ANCHOR)
  while IFS= read -r l; do
    [ -f "$CA_PUB" ] && "$l" anchor --remove "$CA_PUB" >/dev/null 2>&1 && { say "p11-kit anchor removed"; n=$((n + 1)); }
  done < <(rec_get P11KIT)
  while IFS= read -r l; do
    u="${l%%:*}"; d="${l#*:}"
    id "$u" >/dev/null 2>&1 && command -v certutil >/dev/null 2>&1 \
      && as_user "$u" certutil -d "sql:$d" -D -n guardrail 2>/dev/null && { say "NSS: guardrail removed from $d ($u)"; n=$((n + 1)); }
  done < <(rec_get NSS)
  while IFS= read -r l; do
    case "$l" in /etc/environment.d/*guardrail*|/etc/profile.d/*guardrail*) rm -f "$l" && { say "removed $l"; n=$((n + 1)); } ;; esac
  done < <(rec_get ENVFILE)
  [ "$n" -gt 0 ] || say "nothing recorded to remove; the install record names no trust entries"
  say "trust removed; the CA files stay (ca-trust puts it back, uninstall removes them)"
}

case "${1:-}" in
  install)
    shift
    case " $* " in
      # plan only: nothing written first, not even the helper
      *" --dry-run "*) ;;
      *) [ "$DEV" = 0 ] && [ "$SELF" != "$HELPER_PATH" ] && self_install "$@" ;;
    esac
    install_all "$@"
    ;;
  uninstall) uninstall ;;
  verify) verify ;;
  requirements) [ "${2:-}" = --install ] && [ "$(id -u)" -ne 0 ] && die "requirements --install needs root: sudo $SELF requirements --install"
                requirements_report || { [ "${2:-}" = --install ] && requirements_install; } ;;
  status) status ;;
  set-sync) set_sync; chown_data ;;
  endpoints) shift; endpoints "$@" ;;
  mode) need_owner; set_mode "${2:-}" ;;
  proxy-start) proxy_start "${2:-$PUSER}" ;;
  proxy-stop) proxy_stop ;;
  arm) arm "${2:-15m}" ;;
  disarm) disarm ;;
  failsafe-fire) failsafe_fire ;;
  failsafe-test) failsafe_test "${2:-20}" ;;
  units-install) units_install ;;
  units-enable) units_enable ;;
  units-remove) units_remove ;;
  user-add) user_add ;;
  journal) show_journal "${2:-}" ;;
  seal-logs) seal_logs ;;
  purge-logs) purge_logs ;;
  revoke) revoke ;;
  rollback) rollback ;;
  ca-status) ca_status ;;
  ca-trust) ca_trust ;;
  ca-untrust) ca_untrust ;;
  *) usage; exit 2 ;;
esac
