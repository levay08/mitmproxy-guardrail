proxy_up() {
  command -v ss >/dev/null 2>&1 || die "ss not found: install iproute2"
  ss -ltnH "sport = :$PORT" | grep -q .
}

# the regular listener is the one the PAC points at
regular_up() {
  ss -ltnH "sport = :$REGULAR_PORT" | grep -q .
}

# account names of processes listening on the port
listener_users() {
  local pid
  for pid in $(ss -ltnpH "sport = :$PORT" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u); do
    stat -c %U "/proc/$pid" 2>/dev/null
  done | sort -u | tr '\n' ' '
}

# True when one of the given listener accounts is root.
listener_is_root() { case " $1 " in *" root "*) return 0 ;; *) return 1 ;; esac; }

# "owner:" takes their login group, not always same name
chown_data() { [ -n "$APP" ] && [ -n "$OWNER" ] && [ -d "$APP/data" ] && chown -R "$OWNER:" "$APP/data" "$APP/logs" 2>/dev/null; return 0; }

ensure_table() {
  need_nft
  $NFT list table inet guardrail >/dev/null 2>&1 || $NFT add table inet guardrail
  $NFT list set inet guardrail ai4 >/dev/null 2>&1 \
    || $NFT add set inet guardrail ai4 '{ type ipv4_addr; flags interval; }'
  $NFT list set inet guardrail ai6 >/dev/null 2>&1 \
    || $NFT add set inet guardrail ai6 '{ type ipv6_addr; flags interval; }'
  $NFT list set inet guardrail nat64 >/dev/null 2>&1 \
    || $NFT add set inet guardrail nat64 '{ type ipv6_addr; flags interval; }'
  $NFT list chain inet guardrail divert >/dev/null 2>&1 \
    || $NFT 'add chain inet guardrail divert { type nat hook output priority -100; policy accept; }'
  # nat chains cannot reject: QUIC reject needs a filter chain
  $NFT list chain inet guardrail quic >/dev/null 2>&1 \
    || $NFT 'add chain inet guardrail quic { type filter hook output priority -150; policy accept; }'
}

# read one cache; outcome noted for endpoints
sync_read() {
  local who="$1" kind="$2" label="$3" src="$4" dst="$5"
  if as_user "$who" cat "$src" >"$dst" 2>/dev/null; then
    SYNC_SRCS+=("$kind:$dst"); SYNC_NOTES+=("$kind|$label|$src|ok|$dst")
  else
    # a path that cannot be searched is unreadable, not absent
    case "$(LC_ALL=C stat -- "$src" 2>&1)" in
      *"No such file"*) SYNC_NOTES+=("$kind|$label|$src|absent|") ;;
      *) SYNC_NOTES+=("$kind|$label|$src|unreadable as $who|") ;;
    esac
  fi
}

# collect endpoint JSON into a root-only temp dir
sync_collect() {
  local tmp="$1"
  SYNC_SRCS=()
  SYNC_NOTES=()
  # read as the owner into root-only tmp; symlinks cannot mislead
  if [ -n "$APP" ] && [ -n "$OWNER" ] && [ "$UID_TARGET" != 0 ]; then
    sync_read "$OWNER" ep owner-cache "$APP/data/endpoint-ips.json" "$tmp/router.json"
    sync_read "$OWNER" pr providers "$APP/data/provider-addresses.json" "$tmp/providers.json"
  fi
  if puser_exists; then
    sync_read "$PUSER" ep proxy-cache "$STATE/data/endpoint-ips.json" "$tmp/proxy.json"
  else
    SYNC_NOTES+=("ep|proxy-cache|$STATE/data/endpoint-ips.json|absent: no $PUSER user|")
  fi
  [ "${#SYNC_SRCS[@]}" -gt 0 ]
}

# build $LIST, $LIST6 and $LISTNAT from kind:path specs in $@
build_lists() {
  # typed sets: v4 and v6 split; -I isolates the interpreter
  # NAT64_SITE: venv libs, so PyYAML is found without the venv python
  rm -f "$LIST6.skipped"  # a dead build must not leave a stale count
  NAT64_CFG="${RUN_APP:+$RUN_APP/guardrail.yaml}" NAT64_OUT="${LISTNAT:-}" \
    NAT64_SITE="${VENV:+$VENV/lib}" python3 -I - "$LIST" "$LIST6" "$@" <<'PY'
import glob, ipaddress, json, os, sys

out4, out6 = sys.argv[1:3]
outnat = os.environ.get("NAT64_OUT", "")
v4, v6, dropped, hosts = set(), set(), 0, 0

def take(addrs):
    global dropped
    for a in addrs if isinstance(addrs, list) else []:
        try:
            ip = ipaddress.ip_address(str(a))
        except ValueError:
            dropped += 1
            continue
        (v6 if ip.version == 6 else v4).add(str(ip))

for spec in sys.argv[3:]:
    kind, path = spec.split(":", 1)
    try:
        data = json.load(open(path))
    except Exception:
        sys.exit(f"cannot read {kind} list")
    if kind == "ep" and isinstance(data, dict):
        for addrs in data.values():
            hosts += 1
            take(addrs)
    elif kind == "pr" and isinstance(data, dict):
        for entry in data.get("resolved", []):
            hosts += 1
            take(entry.get("addresses", []))
        for entry in data.get("resolved_v6", []):
            take(entry.get("addresses_v6", []))

def global_v6():
    """True when an interface has a global IPv6 address."""
    try:
        path = os.environ.get("GUARDRAIL_IF_INET6", "/proc/net/if_inet6")
        return any(line[:1] in ("2", "3") for line in open(path))
    except OSError:
        return True

# dead v6 uplink hangs clients; reset sends them to IPv4
no_v6 = not global_v6()
skipped_v6 = len(v6) if no_v6 else 0
if no_v6:
    v6.clear()

WKP = "64:ff9b::/96"
NAT64_LENS = (32, 40, 48, 56, 64, 96)


def nat64_prefixes():
    """Valid NAT64 prefixes from guardrail.yaml, plus a note per skipped entry."""
    notes, cfg = [], os.environ.get("NAT64_CFG", "")
    raw = None
    if cfg:
        try:
            if not os.path.exists(cfg):
                raise FileNotFoundError("not found")
            if os.path.islink(cfg) or not os.path.isfile(cfg) or os.path.getsize(cfg) > 1 << 20:
                raise ValueError("not a plain file under 1 MiB")
            try:
                import yaml
            except ImportError:
                site = os.environ.get("NAT64_SITE", "")
                sys.path[:0] = glob.glob(site + "/python3*/site-packages") if site else []
                import yaml
            doc = yaml.safe_load(open(cfg, encoding="utf-8")) or {}
            raw = doc.get("nat64_prefixes") if isinstance(doc, dict) else None
        except Exception as exc:
            # the type only: a parse error text can quote the file
            notes.append(f"nat64_prefixes: {cfg} not read ({type(exc).__name__}); default {WKP} used")
    if raw is None:
        return [ipaddress.ip_network(WKP)], notes
    if isinstance(raw, str):
        raw = [raw]
    if not isinstance(raw, list):
        notes.append(f"nat64_prefixes: must be a list, got {type(raw).__name__}; default {WKP} used")
        return [ipaddress.ip_network(WKP)], notes
    good = []
    for entry in raw:
        if not isinstance(entry, str):
            notes.append(f"nat64_prefixes: skipped {entry!r}: not a string")
            continue
        text = entry.strip()
        try:
            net = ipaddress.ip_network(text, strict=True)
        except ValueError as exc:
            notes.append(f"nat64_prefixes: skipped {text!r}: {exc}")
            continue
        if net.version != 6:
            notes.append(f"nat64_prefixes: skipped {text!r}: IPv4, a NAT64 prefix is IPv6")
        elif net.prefixlen not in NAT64_LENS:
            notes.append(f"nat64_prefixes: skipped {text!r}: /{net.prefixlen} is not one of "
                         "/32 /40 /48 /56 /64 /96 (RFC 6052)")
        elif net.is_multicast or net.is_loopback or net.is_link_local or net.is_unspecified:
            notes.append(f"nat64_prefixes: skipped {text!r}: not a routable unicast range")
        else:
            outer = next((g for g in good if net.subnet_of(g)), None)
            if outer is not None:
                notes.append(f"nat64_prefixes: skipped {text!r}: already covered by {outer}")
                continue
            for inner in (g for g in good if g.subnet_of(net)):
                notes.append(f"nat64_prefixes: skipped {str(inner)!r}: covered by {net}")
            good = [g for g in good if not g.subnet_of(net)] + [net]
    if not good:
        notes.append(f"nat64_prefixes: no usable entry; default {WKP} used")
        good = [ipaddress.ip_network(WKP)]
    return good, notes


def nat64_form(net, a):
    """The RFC 6052 address of IPv4 a inside prefix net (u octet 8 stays zero)."""
    out = bytearray(net.network_address.packed)
    idx = net.prefixlen // 8
    for octet in ipaddress.IPv4Address(a).packed:
        if idx == 8:
            idx += 1
        out[idx] = octet
        idx += 1
    return str(ipaddress.IPv6Address(bytes(out)))


# DNS64 clients dial <prefix>+<v4>; map watched v4 into ai6
prefixes, nat_notes = nat64_prefixes()
nat64 = set() if no_v6 else {nat64_form(n, a) for n in prefixes for a in v4}
open(out4, "w").write(", ".join(sorted(v4)))
open(out6, "w").write(", ".join(sorted(v6 | nat64)))
open(out6 + ".skipped", "w").write(f"{int(no_v6)} {skipped_v6}\n")
if outnat:
    open(outnat, "w").write(", ".join(str(n) for n in sorted(prefixes)))
for note in nat_notes:
    print(note)
print(f"{len(v4)} v4 + {len(v6)} v6 addresses from {hosts} host entries in {len(sys.argv) - 3} files, "
      f"{dropped} dropped as invalid" + (f", {skipped_v6} v6 skipped: no global IPv6 address" if no_v6 else "")
      + (f", {len(nat64)} NAT64 forms of the v4 set added to ai6 "
         f"from {len(prefixes)} prefix(es): {', '.join(str(n) for n in sorted(prefixes))}" if nat64 else ""))
PY
}

# Write the built lists into the typed nft sets.
apply_sets() {
  ensure_table
  # One transaction: a half-filled set never replaces a working one.
  local tmp
  tmp="$(mktemp)" || die "mktemp failed"
  {
    printf 'flush set inet guardrail ai4\n'
    printf 'add element inet guardrail ai4 { %s }\n' "$(cat "$LIST")"
    printf 'flush set inet guardrail ai6\n'
    [ -s "$LIST6" ] && printf 'add element inet guardrail ai6 { %s }\n' "$(cat "$LIST6")"
    printf 'flush set inet guardrail nat64\n'
    [ -s "${LISTNAT:-}" ] && printf 'add element inet guardrail nat64 { %s }\n' "$(cat "$LISTNAT")"
  } > "$tmp"
  if $NFT -f "$tmp"; then
    say "set ai4 refreshed from $(tr ',' '\n' < "$LIST" | grep -c '[0-9]') addresses"
    if [ -s "$LIST6" ]; then
      say "set ai6 refreshed from $(tr ',' '\n' < "$LIST6" | grep -c '[0-9a-fA-F]') addresses"
    else
      local flag="" skipped=0
      read -r flag skipped <"$LIST6.skipped" 2>/dev/null || true
      if [ "$flag" = 1 ]; then
        say "set ai6 empty by design: no global IPv6 address on this host, $skipped v6 skipped; AI v6 is reset so clients use IPv4"
      else
        say "set ai6 left empty: the endpoint lists hold no IPv6 addresses"
      fi
    fi
  else
    rm -f "$tmp"
    die "the address sets could not be replaced: the previous sets are untouched, so nothing changed"
  fi
  rm -f "$tmp"
  if ! $NFT list set inet guardrail ai4 2>/dev/null | grep -qE 'elements = |elements = \{'; then
    die "the ai4 set came out empty: nothing would be diverted"
  fi
}

set_sync() {
  need_python
  local tmp
  tmp="$(mktemp -d)" || die "mktemp failed"
  sync_collect "$tmp" || { rm -rf "$tmp"; die "no endpoint list: neither ${APP:-the project}/data nor $STATE/data has endpoint-ips.json"; }
  build_lists "${SYNC_SRCS[@]}" || { rm -rf "$tmp"; die "the address lists could not be built"; }
  rm -rf "$tmp"
  [ -s "$LIST" ] || die "the address list came out empty"
  apply_sets
}

# read-only: the list set_sync would build, per host, with sources
endpoints() {
  need_python
  local tmp h built=0 rc
  local -a extra=()
  for h in "$@"; do
    case "$h" in ''|*[!A-Za-z0-9.-]*) die "not a host name; give plain names such as api.example.com" ;; esac
    extra+=("$h")
  done
  tmp="$(mktemp -d)" || die "mktemp failed"
  sync_collect "$tmp" || true
  printf '%s\n' "${SYNC_NOTES[@]}" >"$tmp/notes"
  # the real lists stay as the last arm left them
  local old4="$LIST" old6="$LIST6" LIST="$tmp/ai4" LIST6="$tmp/ai6" LISTNAT="$tmp/nat"
  if [ "${#SYNC_SRCS[@]}" -gt 0 ]; then
    build_lists "${SYNC_SRCS[@]}" >"$tmp/build.txt" 2>&1 && built=1
  fi
  : >>"$tmp/build.txt"; : >>"$LIST"; : >>"$LIST6"
  ENDPOINTS_BUILT="$built" ENDPOINTS_SITE="${VENV:+$VENV/lib}" python3 -I - \
    "$tmp/notes" "$LIST" "$LIST6" "$old4" "$old6" "$tmp/build.txt" \
    "${RUN_APP:+$RUN_APP/guardrail.yaml}" ${extra[@]+"${extra[@]}"} <<'PY'
import glob, ipaddress, json, os, re, sys, time

notes_file, new4, new6, old4, old6, build_txt, cfg = sys.argv[1:8]
extras = sys.argv[8:]
built = os.environ.get("ENDPOINTS_BUILT") == "1"
NAME = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$")


def when(path):
    try:
        return time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(os.stat(path).st_mtime))
    except OSError:
        return "time unknown"


def words(path):
    try:
        return {w.strip() for w in open(path).read().split(",") if w.strip()}
    except OSError:
        return None


def fixed_hosts(pattern):
    """Literal host names a provider pattern can name; mirrors rules.py."""
    text = pattern.strip().lstrip("^").rstrip("$").replace("\\.", "\x00")
    variants = [text]
    group = re.compile(r"\((?:\?:)?([^()]*)\)(\?)?")
    for _ in range(4):
        grown, changed = [], False
        for variant in variants:
            hit = group.search(variant)
            if not hit:
                grown.append(variant)
                continue
            changed = True
            options = hit.group(1).split("|") + ([""] if hit.group(2) else [])
            grown += [variant[:hit.start()] + o + variant[hit.end():] for o in options]
        variants = list(dict.fromkeys(grown))[:16]
        if not changed:
            break
    out = []
    for variant in variants:
        for expanded in ([variant] if "?" not in variant else
                         [re.sub(r"(.)\?", r"\1", variant, count=1), re.sub(r".\?", "", variant, count=1)]):
            plain = expanded.replace("\x00", ".")
            if re.search(r"[\[\](){}*+?|^$\\]", plain) or "." not in plain or plain.startswith(".") or ".." in plain:
                continue
            out.append(plain)
    return list(dict.fromkeys(out))


hosts, bad_names, bad_addrs = {}, 0, 0


def add(label, name, addrs):
    global bad_names, bad_addrs
    if not isinstance(name, str) or not NAME.match(name):
        bad_names += 1
        return
    ent = hosts.setdefault(name.lower(), {"src": set(), "v4": set(), "v6": set()})
    ent["src"].add(label)
    for a in addrs if isinstance(addrs, list) else []:
        try:
            ip = ipaddress.ip_address(str(a))
        except ValueError:
            bad_addrs += 1
            continue
        ent["v6" if ip.version == 6 else "v4"].add(str(ip))


print("endpoints: read-only; same collection and parser as arm and set-sync")
print("== sources")
rc, readable = 0, 0
for line in open(notes_file):
    if "|" not in line:
        continue
    kind, label, path, status, tmp = line.rstrip("\n").split("|", 4)
    count = ""
    if status == "ok":
        try:
            data = json.load(open(tmp))
            before = len(hosts)
            if kind == "ep" and isinstance(data, dict):
                for name, addrs in data.items():
                    add(label, name, addrs)
            elif kind == "pr" and isinstance(data, dict):
                for entry in data.get("resolved", []):
                    add(label, entry.get("host"), entry.get("addresses", []))
                for entry in data.get("resolved_v6", []):
                    add(label, entry.get("host"), entry.get("addresses_v6", []))
            readable += 1
            count = f"  {len(hosts) - before} new hosts"
        except Exception:
            status = "unparseable (arm would stop here)"
    if status.startswith("unreadable") or status.startswith("unparseable"):
        rc = 1
    stamp = when(path) if status == "ok" else ""
    print(f"  {label:<12} {status:<26} {stamp:<28} {path}{count}")
if readable == 0:
    rc = 1
    print("  no cache could be read: nothing below describes what arm would use")

v4 = {a for e in hosts.values() for a in e["v4"]}
v6 = {a for e in hosts.values() for a in e["v6"]}
print(f"== effective list: {len(hosts)} hosts, {len(v4)} v4 and {len(v6)} v6 addresses"
      + (f"; {bad_names} names and {bad_addrs} addresses dropped as invalid" if bad_names or bad_addrs else ""))
for name in sorted(hosts):
    e = hosts[name]
    addrs = " ".join(sorted(e["v4"])) + (" | " if e["v4"] and e["v6"] else "") + " ".join(sorted(e["v6"]))
    print(f"  {name}  [{','.join(sorted(e['src']))}]  {len(e['v4'])}v4 {len(e['v6'])}v6  {addrs}")

print("== expected hosts")
patterns, why = [], ""
try:
    if not cfg:
        raise ValueError("no guardrail.yaml path")
    if os.path.islink(cfg) or not os.path.isfile(cfg) or os.path.getsize(cfg) > 1 << 20:
        raise ValueError("not a plain file under 1 MiB")
    try:
        import yaml
    except ImportError:
        site = os.environ.get("ENDPOINTS_SITE", "")
        sys.path[:0] = glob.glob(site + "/python3*/site-packages") if site else []
        import yaml
    doc = yaml.safe_load(open(cfg, encoding="utf-8")) or {}
    raw = doc.get("providers") if isinstance(doc, dict) else None
    patterns = [p for p in raw if isinstance(p, str)] if isinstance(raw, list) else []
    print(f"  from the providers list in {cfg} and {len(extras)} name(s) on the command line")
except Exception as exc:
    why = type(exc).__name__
    print(f"  providers list NOT read ({why}); only the {len(extras)} name(s) on the command line are checked")
expected = list(extras)
for pat in patterns:
    found = [h for h in fixed_hosts(pat) if not h.startswith("127.")]
    if not found and not pat.startswith("127"):
        print(f"  pattern  {pat}  no fixed host name; cannot be checked by name")
    expected += found
absent = []
gap = ("; a source above was unreadable, so this may be a read gap" if rc == 1 else "")
for name in dict.fromkeys(h.lower() for h in expected):
    e = hosts.get(name)
    n = len(e["v4"]) + len(e["v6"]) if e else 0
    if n:
        print(f"  present  {name}  {n} addresses")
    else:
        absent.append(name)
        print(f"  ABSENT   {name}  {'listed with no address' if e else 'not in any cache that was read'}{gap}")

print("== against the build arm and set-sync wrote last")
summary = [ln for ln in open(build_txt).read().splitlines() if ln.strip()]
for ln in summary:
    print(f"  fresh build: {ln}")
if not built:
    print("  fresh build: not run (no readable cache, or the build failed)")
else:
    nv4 = words(new4) or set()
    nv6 = words(new6) or set()
    print(f"  per-host listing vs fresh build: v4 {'agree' if nv4 == v4 else 'DIFFER'}; "
          f"v6 {'agree' if v6 <= nv6 else 'listing has ' + str(len(v6 - nv6)) + ' not in the build (no global IPv6 uplink drops them)'}")
    for fam, fresh, path in (("v4", nv4, old4), ("v6", nv6, old6)):
        last = words(path)
        if last is None:
            print(f"  {fam}: no earlier build in {path} (nothing armed or synced since boot)")
            continue
        add_, gone = sorted(fresh - last), sorted(last - fresh)
        verdict = "same as the fresh list" if not add_ and not gone else "DIFFERS from the fresh list"
        print(f"  {fam}: last build {when(path)}, {len(last)} addresses, {verdict}")
        if add_:
            print(f"     in the caches now, not in the last build ({len(add_)}): {' '.join(add_[:20])}")
        if gone:
            print(f"     in the last build, not in the caches now ({len(gone)}): {' '.join(gone[:20])}")
print("== what this cannot show")
print("  it does not read the live nft sets, only /run lists, and not hosts a client resolves later")
print("  an address the cache holds for a name says nothing about who else shares that address")
if absent and rc == 0:
    rc = 3
print(f"result: {'ok' if rc == 0 else 'sources unreadable' if rc == 1 else str(len(absent)) + ' expected host(s) absent'}")
sys.exit(rc)
PY
  rc=$?
  rm -rf "$tmp"
  return "$rc"
}

# nft lists "counter packets N bytes M" before the verdict
CNT_RE='counter( packets [0-9]+ bytes [0-9]+)?'

# nft answers and has no guardrail table
nft_absent() {
  local t
  [ -n "$NFT" ] || return 1
  t="$($NFT list tables 2>/dev/null)" || return 1
  ! grep -q "inet guardrail" <<<"$t"
}

# 0 match, 1 no match, 2 nft unreadable
chain_has() {
  local out
  [ -n "$NFT" ] || return 2
  out="$($NFT list chain inet guardrail "$1" 2>/dev/null)" || return 2
  grep -qE "meta skuid $UID_TARGET .*$2" <<<"$out"
}

# 0 both families divert, 1 not, 2 unreadable
rule_present() {
  local r4=0 r6=0
  chain_has divert "ip daddr @ai4 $CNT_RE redirect to :$PORT\$" || r4=$?
  chain_has divert "ip6 daddr @ai6 $CNT_RE redirect to :$PORT\$" || r6=$?
  if [ "$r4" = 0 ] && [ "$r6" = 0 ]; then return 0; fi
  if [ "$r4" = 2 ] || [ "$r6" = 2 ]; then
    nft_absent && return 1
    return 2
  fi
  return 1
}

add_rule() {
  need_owner
  ensure_table
  $NFT flush chain inet guardrail divert
  $NFT add rule inet guardrail divert meta skuid "$UID_TARGET" tcp dport 443 \
    ip daddr @ai4 counter redirect to ":$PORT"
  $NFT add rule inet guardrail divert meta skuid "$UID_TARGET" tcp dport 443 \
    ip6 daddr @ai6 counter redirect to ":$PORT"
  # no QUIC proxy: reject so clients fall back to TCP
  $NFT flush chain inet guardrail quic
  $NFT add rule inet guardrail quic meta skuid "$UID_TARGET" udp dport 443 \
    ip daddr @ai4 counter reject
  $NFT add rule inet guardrail quic meta skuid "$UID_TARGET" udp dport 443 \
    ip6 daddr @ai6 counter reject
  # empty nat64 set: keep the well-known prefix exempt, as before
  $NFT list set inet guardrail nat64 | grep -q 'elements = ' \
    || $NFT add element inet guardrail nat64 '{ 64:ff9b::/96 }'
  # QUIC like TCP: v6 outside ai6 must not depend on set contents
  $NFT add rule inet guardrail quic meta skuid "$UID_TARGET" udp dport 443 \
    ip6 daddr != @ai6 ip6 daddr != @nat64 counter reject
  # reset real AAAA outside ai6; NAT64 prefixes outside ai6 pass
  $NFT add rule inet guardrail quic meta skuid "$UID_TARGET" tcp dport 443 \
    ip6 daddr != @ai6 ip6 daddr != @nat64 counter reject with tcp reset
  # a failed add is not an installed rule
  local chain
  for chain in divert quic; do
    $NFT list chain inet guardrail "$chain" >/dev/null 2>&1 \
      || die "chain $chain is missing; nothing would be diverted. Check: $NFT list chain inet guardrail $chain"
  done
  local cnt="$CNT_RE"
  chain_has divert "ip daddr @ai4 $cnt redirect to :$PORT\$" \
    || die "the IPv4 redirect is not in the chain: nothing would be diverted"
  chain_has divert "ip6 daddr @ai6 $cnt redirect to :$PORT\$" \
    || die "the IPv6 redirect is not in the chain: nothing would be diverted"
  chain_has quic "ip daddr @ai4 $cnt reject" \
    || die "the QUIC reject for IPv4 is missing: UDP 443 would leave the guardrail"
  chain_has quic "ip6 daddr @ai6 $cnt reject" \
    || die "the QUIC reject for IPv6 is missing: UDP 443 would leave the guardrail"
  chain_has quic "udp dport 443 ip6 daddr != @ai6 ip6 daddr != @nat64 $cnt reject" \
    || die "the v6 QUIC reject outside ai6 is missing: UDP 443 over v6 would leave the guardrail"
  chain_has quic "tcp dport 443 ip6 daddr != @ai6 ip6 daddr != @nat64 $cnt reject with tcp reset" \
    || die "the IPv6 TCP reject is missing: real-AAAA hosts would hang on a dead IPv6 uplink"
  say "rule installed for uid $UID_TARGET on port 443 (tcp redirect + udp/quic reject, ipv4 and ipv6)"
}

arm_failsafe() {
  local dur="${1:-15min}" secs pid
  case "$dur" in *[!0-9a-z]*) die "bad duration: $dur" ;; esac
  case "$dur" in [0-9]*) ;; *) die "bad duration: $dur" ;; esac
  secs="$(to_seconds "$dur")" || die "bad duration: $dur"
  case "$(failsafe_method)" in
    systemd) ;;
    background)
      # no systemd: detached sleeper must be alive before add_rule
      if [ -f "$FSPID" ]; then kill "$(cat "$FSPID")" 2>/dev/null; rm -f "$FSPID"; fi
      setsid nohup /bin/sh -c "sleep $secs; exec '$SELF' failsafe-fire" >/dev/null 2>&1 </dev/null &
      pid=$!
      echo "$pid" >"$FSPID"
      sleep 0.3
      kill -0 "$pid" 2>/dev/null || die "the background failsafe did not stay up; no rule installed"
      say "failsafe armed for $dur as background pid $pid (no systemd here)"
      return 0 ;;
    *) die "no systemd and no setsid/sleep: the rule cannot remove itself, so it is not installed" ;;
  esac
  cat >"$UNITDIR/$UNIT.service" <<EOF
[Unit]
Description=Guardrail failsafe: flush the divert chain
[Service]
Type=oneshot
ExecStart=$SELF failsafe-fire
EOF
  cat >"$UNITDIR/$UNIT.timer" <<EOF
[Unit]
Description=Guardrail failsafe timer
[Timer]
OnActiveSec=$dur
AccuracySec=1s
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  # stop the service too, or an elapsed cycle fires it
  systemctl stop "$UNIT.timer" "$UNIT.service" >/dev/null 2>&1
  systemctl reset-failed "$UNIT.service" "$UNIT.timer" >/dev/null 2>&1
  systemctl start "$UNIT.timer" || die "the failsafe timer did not start"
  say "failsafe armed for $dur"
  systemctl list-timers "$UNIT.timer" --no-pager | sed -n 2p
}

failsafe_fire() {
  local c n=0
  for c in divert quic; do
    [ -n "$NFT" ] && $NFT list chain inet guardrail "$c" >/dev/null 2>&1 || continue
    if $NFT flush chain inet guardrail "$c"; then n=$((n + 1))
    else say "failsafe: chain $c could NOT be flushed"; fi
  done
  if [ "$n" -gt 0 ]; then say "failsafe fired: $n chain(s) flushed (divert, quic)"
  else say "failsafe fired: no chain to flush"; fi
  rm -f "$FSPID"
  [ "$HAS_SYSTEMD" = 1 ] && systemctl stop "$UNIT.timer" >/dev/null 2>&1
  return 0
}

# Cancel whichever failsafe is armed.
failsafe_cancel() {
  if [ "$HAS_SYSTEMD" = 1 ]; then
    systemctl stop "$UNIT.timer" >/dev/null 2>&1
    systemctl reset-failed "$UNIT.service" "$UNIT.timer" >/dev/null 2>&1
  fi
  if [ -f "$FSPID" ]; then
    kill "$(cat "$FSPID")" 2>/dev/null
    rm -f "$FSPID"
  fi
}

proxy_listeners() {
  # v6 redirect points at ::1; a missing listener is silent
  local v4 v6
  v4="$(ss -ltnH "sport = :$PORT" 2>/dev/null | grep -c '127\.0\.0\.1:' || true)"
  v6="$(ss -ltnH "sport = :$PORT" 2>/dev/null | grep -c '\[::1\]:' || true)"
  printf '%s:%s' "${v4:-0}" "${v6:-0}"
}

listeners_warn() {
  # warn when both IP families are not listening
  case "$(proxy_listeners)" in
    "1:1") return 0 ;;
    "1:0") say "WARNING: only the IPv4 listener is up on port $PORT; the IPv6 redirect points at ::1 and will not be served" ;;
    "0:1") say "WARNING: only the IPv6 listener is up on port $PORT; IPv4 traffic will not be served" ;;
    *) say "WARNING: no listener on port $PORT" ;;
  esac
}

# create the proxy user, or refuse and say why
user_add() {
  local nologin msg
  nologin="$(command -v nologin || echo /bin/false)"
  if puser_exists; then say "$PUSER already exists"
  elif command -v useradd >/dev/null 2>&1; then
    msg="$(useradd --system --user-group --home-dir "$STATE" --no-create-home --shell "$nologin" "$PUSER" 2>&1)" \
      || die "proxy user $PUSER does not exist and could not be created: useradd: $msg"
    say "$PUSER created"
  elif command -v adduser >/dev/null 2>&1; then
    # busybox (Alpine) has adduser only.
    command -v addgroup >/dev/null 2>&1 && addgroup -S "$PUSER" >/dev/null 2>&1
    msg="$(adduser -S -D -H -h "$STATE" -s "$nologin" -G "$PUSER" "$PUSER" 2>&1)" \
      || die "proxy user $PUSER does not exist and could not be created: adduser: $msg"
    say "$PUSER created"
  else
    die "proxy user $PUSER does not exist and could not be created: neither useradd nor adduser found"
  fi
  [ "$(id -u "$PUSER")" != 0 ] || die "$PUSER has uid 0; refusing to use it"
  id "$PUSER"
}

need_puser() {
  puser_exists || user_add >/dev/null
  puser_exists || die "proxy user $PUSER does not exist and could not be created"
  [ "$(id -u "$PUSER")" != 0 ] || die "$PUSER has uid 0; refusing to use it"
  [ "$(id -u "$PUSER")" != "$UID_TARGET" ] || die "$PUSER shares uid $UID_TARGET with the owner; its traffic would loop"
}

# every check that must pass before mitmdump starts
proxy_preflight() {
  need_puser
  if [ "$DEV" = 1 ]; then
    need_app
    [ -x "$MITMDUMP" ] || die "mitmdump not found: $MITMDUMP"
    # dev keeps CA key away: proxy reads its own copy
    if ! [ -f "$CONFDIR/mitmproxy-ca.pem" ]; then make_dirs; install_ca; fi
    as_puser test -r "$APP/guardrail.py" && as_puser test -x "$MITMDUMP" \
      || die "--dev: $PUSER cannot read $APP or run $MITMDUMP ($(describe "$USER_HOME")); dev mode needs that tree readable by $PUSER"
  else
    [ -x "$MITMDUMP" ] || die "refusing to start the proxy: $MITMDUMP is missing; run: guardrail-adm install"
    tree_ok "$VENV" 1 || die "refusing to start the proxy: $BAD; the venv must be owned by root and writable by nobody else"
    tree_ok "$IAPP" || die "refusing to start the proxy: $BAD; the app copy must be owned by root and writable by nobody else"
  fi
  puser_dir_ok "$CONFDIR" 700 || die "refusing to start the proxy: $BAD"
  [ -f "$CONFDIR/mitmproxy-ca.pem" ] || die "refusing to start the proxy: no CA in $CONFDIR; run: guardrail-adm install"
  puser_dir_ok "$STATE" 750 || die "refusing to start the proxy: $BAD"
  audit_dir_ok || die "refusing to start the proxy: $BAD; reinstall with guardrail-adm install"
  # bad weights tree is removed, never loaded
  if [ -d "$HFDIR" ] && ! tree_ok "$HFDIR"; then
    say "WARNING: removing $HFDIR ($BAD); model layer off until: guardrail-adm install"
    log "model tree removed before start: $BAD"
    rm -rf "$HFDIR"
  fi
  # a new audit file must come back group-readable
  if [ "$(id -u)" -eq 0 ]; then add_audit_file; fi
}

# the one command line the proxy runs with
build_proxy_cmd() {
  PROXY_CMD=(env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME="$STATE" LANG=C.UTF-8
    GUARDRAIL_HOME="$STATE" GUARDRAIL_PAC="$PACDIR/guardrail.pac" GUARDRAIL_PAC_PROXY="127.0.0.1:$REGULAR_PORT" GUARDRAIL_CONFIG="$RUN_APP/guardrail.yaml"
    GUARDRAIL_ATR_DIR="$RUN_APP/atr" GUARDRAIL_DLP_DIR="$RUN_APP/data/dlp"
    HF_HOME="$HFDIR" HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1
    "$MITMDUMP" --mode transparent --mode "transparent@::1:$PORT" \
    --mode "regular@127.0.0.1:$REGULAR_PORT" \
    --listen-host 127.0.0.1 --listen-port "$PORT" --set confdir="$CONFDIR"
    --set http3=false --set flow_detail=1 -s "$RUN_APP/guardrail.py")
}

write_runner() {
  build_proxy_cmd
  install -d -o root -g root -m 0755 "$LIBDIR/bin"
  {
    echo '#!/bin/sh'
    echo "# Guardrail proxy, written by guardrail-adm install. Runs as $PUSER, never as root."
    echo '[ "$(id -u)" -ne 0 ] || { echo "guardrail proxy: refusing to run as root" >&2; exit 1; }'
    echo 'umask 077'
    printf 'exec >>%q 2>&1\n' "$PROXY_LOG"
    printf 'exec'; printf ' %q' "${PROXY_CMD[@]}"; echo
  } >"$RUNNER.tmp"
  chmod 0755 "$RUNNER.tmp"
  mv -f "$RUNNER.tmp" "$RUNNER"
}

unit_installed() { [ "$HAS_SYSTEMD" = 1 ] && [ -f "$UNITDIR/guardrail-proxy.service" ]; }

proxy_start() {
  local who="${1:-$PUSER}" users
  case "$who" in
    "$PUSER") ;;
    root) say "note: the proxy no longer runs as root; starting it as $PUSER" ;;
    *) die "unknown user: $who (the proxy only runs as $PUSER)" ;;
  esac
  if proxy_up; then
    users="$(listener_users)"
    say "already listening on $PORT (as: ${users:-unknown})"
    listener_is_root "$users" && say "WARNING: a proxy running as root holds port $PORT; run proxy-stop, then proxy-start"
    return 0
  fi
  proxy_preflight
  if [ "$DEV" != 1 ] && unit_installed; then
    chain_ok "$RUNNER" || die "refusing to start the proxy: $BAD"
    systemctl start guardrail-proxy.service || die "guardrail-proxy.service did not start"
  else
    build_proxy_cmd
    local drop=() detach=()
    if command -v runuser >/dev/null 2>&1; then drop=(runuser -u "$PUSER" --)
    elif command -v setpriv >/dev/null 2>&1; then
      drop=(setpriv --reuid="$(id -u "$PUSER")" --regid="$(id -g "$PUSER")" --init-groups --)
    else die "neither runuser nor setpriv found: cannot drop to $PUSER, so the proxy is not started"
    fi
    command -v setsid >/dev/null 2>&1 && detach=(setsid)
    # proxy shell opens the log: no root write through symlink
    "${detach[@]}" nohup "${drop[@]}" /bin/sh -c 'umask 077; exec "$@" >>"$0" 2>&1' \
      "$PROXY_LOG" "${PROXY_CMD[@]}" >/dev/null 2>&1 </dev/null &
  fi
  for _ in $(seq 1 60); do proxy_up && break; sleep 0.5; done
  proxy_up || { as_puser tail -5 "$PROXY_LOG" 2>&1; die "the proxy did not start"; }
  pgrep -u "$PUSER" -f 'mitmdump --mode transparent' >"$PIDFILE"
  users="$(listener_users)"
  listener_is_root "$users" && { proxy_stop; die "the listener came up as root; stopped it"; }
  say "proxy started as $PUSER, pid $(tr '\n' ' ' <"$PIDFILE")$([ "$DEV" = 1 ] && echo ' [dev]')"
}

set_mode() {
  local want="${1:-}"
  case "$want" in
    neutral|persistent) ;;
    *) die "unknown mode '$want': use neutral or persistent" ;;
  esac
  [ -d "$STATE" ] || die "no installed state at $STATE; run install first"
  # root never writes through a symlink in $STATE
  [ -L "$STATE/mode" ] && die "refusing to write through a symlink: $STATE/mode"
  as_puser /bin/sh -c 'umask 022; printf "%s\n" "$1" >"$2"' sh "$want" "$STATE/mode" \
    || die "could not write $STATE/mode as $PUSER"
  say "mode set to $want ($STATE/mode)"
}


# desktop proxy preamble: prints skip reason, returns non-zero
desktop_proxy_ready() {
  [ -n "$OWNER" ] && [ "$UID_TARGET" != 0 ] || { say "desktop proxy step skipped: owner unknown"; return 1; }
  desktop_tool
  [ -n "$TOOL" ] || { say "desktop proxy step skipped: $SKIP"; return 1; }
}

# Ask a running KDE session to re-read its proxy settings.
kde_reparse() {
  local bus="$1"
  [ -n "$bus" ] && command -v dbus-send >/dev/null 2>&1 || return 0
  as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" dbus-send --type=signal /KIO/Scheduler \
    org.kde.KIO.Scheduler.reparseSlaveConfiguration string: 2>/dev/null
}

# Remember the owner's proxy setting before changing it
save_desktop_proxy() {
  desktop_proxy_ready || return 0
  local f="$VARDIR/desktop-proxy.saved" bus mode url ptype pscript
  [ -e "$f" ] && return 0              # one save per armed stretch
  [ -L "$f" ] && { say "saved-proxy path is a symlink; not written: $f"; return 0; }
  bus="$(owner_bus)"
  case "$TOOL" in
    *gsettings)
      [ -n "$bus" ] || { say "desktop proxy not saved: no session bus for $OWNER"; return 0; }
      mode="$(as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" get org.gnome.system.proxy mode 2>/dev/null)"
      url="$(as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" get org.gnome.system.proxy autoconfig-url 2>/dev/null)"
      printf 'tool=gsettings\nmode=%s\nurl=%s\n' "$mode" "$url" >"$f" || return 0 ;;
    *)
      ptype="$(as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key ProxyType 2>/dev/null)"
      pscript="$(as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key 'Proxy Config Script' 2>/dev/null)"
      printf 'tool=kde\nmode=%s\nurl=%s\n' "$ptype" "$pscript" >"$f" || return 0 ;;
  esac
  chmod 0600 "$f" 2>/dev/null
  say "owner's desktop proxy setting saved: $f"
}

# Put the owner's setting back; non-zero when none was saved
restore_desktop_proxy() {
  local f="$VARDIR/desktop-proxy.saved"
  [ -f "$f" ] || return 1
  desktop_proxy_ready || return 1
  local tool mode url bus; bus="$(owner_bus)"
  tool="$(sed -n 's/^tool=//p' "$f" | head -1)"
  mode="$(sed -n 's/^mode=//p' "$f" | head -1)"
  url="$(sed -n 's/^url=//p' "$f" | head -1)"
  # gsettings prints its strings quoted
  mode="${mode//\'/}"
  url="${url//\'/}"
  [ -n "$mode" ] || { [ "$tool" = kde ] && mode=0 || mode="none"; }
  case "$tool" in
    gsettings)
      [ -n "$bus" ] || { say "desktop proxy not restored: no session bus for $OWNER"; return 1; }
      if ! as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" set org.gnome.system.proxy mode "$mode" 2>/dev/null; then
        say "could not put the saved proxy mode back; the record is kept: $f"
        return 1
      fi
      if [ -n "$url" ]; then
        as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" set org.gnome.system.proxy autoconfig-url "$url" 2>/dev/null \
          || { say "could not put the saved script address back; the record is kept: $f"; return 1; }
      else
        as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" reset org.gnome.system.proxy autoconfig-url 2>/dev/null
      fi ;;
    kde)
      if ! as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key ProxyType "$mode" 2>/dev/null; then
        say "could not put the saved proxy mode back; the record is kept: $f"
        return 1
      fi
      as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key 'Proxy Config Script' "$url" 2>/dev/null
      kde_reparse "$bus" ;;
    *) say "saved proxy record is unreadable; left in place: $f"; return 1 ;;
  esac
  rm -f "$f"
  say "owner's desktop proxy setting restored (mode $mode${url:+, script $url})"
  return 0
}

# half-applied setting must not stay: put the saved one back
desktop_proxy_undo() {
  if restore_desktop_proxy; then
    say "desktop proxy could not be set through $1; your saved setting was put back"
  else
    say "desktop proxy could not be set through $1; check it, it may be half-changed"
  fi
}

# desktop_proxy from guardrail.yaml; missing reads as off
desktop_proxy_setting() {
  local v
  v="$(sed -n 's/^desktop_proxy:[[:space:]]*\([A-Za-z]*\).*/\1/p' "${RUN_APP:-$APP}/guardrail.yaml" 2>/dev/null | head -1)"
  printf '%s' "${v,,}"
}

desktop_proxy_on() {
  # set owner's PAC here: proxy cannot reach their session
  case "$(desktop_proxy_setting)" in
    on|auto|yes|true) ;;
    *) say "desktop proxy left alone: desktop_proxy is off in guardrail.yaml"; return 0 ;;
  esac
  desktop_proxy_ready || return 0
  regular_up || { say "desktop proxy step skipped: nothing listens on $REGULAR_PORT"; return 0; }
  local pac="$PACDIR/guardrail.pac"
  [ -f "$pac" ] || { say "desktop proxy step skipped: $pac not written yet"; return 0; }
  save_desktop_proxy
  local bus url; bus="$(owner_bus)"; url="file://$pac"
  case "$TOOL" in
    *gsettings)
      if [ -z "$bus" ]; then
        say "desktop proxy not set: no session bus for $OWNER"
        say "  run as $OWNER: gsettings set org.gnome.system.proxy autoconfig-url '$url'"
        return 0
      fi
      if as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" set org.gnome.system.proxy autoconfig-url "$url" 2>/dev/null \
         && as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" set org.gnome.system.proxy mode 'auto' 2>/dev/null; then
        touch "$VARDIR/desktop-proxy.on"
        say "desktop proxy points at $pac (gsettings, $OWNER)"
      else
        desktop_proxy_undo gsettings
      fi ;;
    *)
      if as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key ProxyType 2 2>/dev/null \
         && as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key 'Proxy Config Script' "$url" 2>/dev/null; then
        touch "$VARDIR/desktop-proxy.on"
        say "desktop proxy points at $pac ($(basename "$TOOL"), $OWNER)"
      else
        desktop_proxy_undo "$(basename "$TOOL")"
      fi
      kde_reparse "$bus" ;;
  esac
}


desktop_proxy_off() {
  # restore the owner's setting; reset only something we changed
  if restore_desktop_proxy; then
    rm -f "$VARDIR/desktop-proxy.on"
    return 0
  fi
  if [ ! -e "$VARDIR/desktop-proxy.on" ]; then
    say "the guardrail never changed the desktop proxy setting; leaving it as it is"
    return 0
  fi
  desktop_proxy_ready || return 0
  local bus; bus="$(owner_bus)"
  case "$TOOL" in
    *gsettings)
      if [ -z "$bus" ]; then
        say "desktop proxy not reset: no session bus for $OWNER"
        say "  run as $OWNER: gsettings set org.gnome.system.proxy mode 'none'"
        return 0
      fi
      as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" set org.gnome.system.proxy mode 'none' 2>/dev/null
      as_owner env "DBUS_SESSION_BUS_ADDRESS=$bus" "$TOOL" reset org.gnome.system.proxy autoconfig-url 2>/dev/null
      rm -f "$VARDIR/desktop-proxy.on"
      say "desktop proxy reset via gsettings for $OWNER" ;;
    *)
      as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key ProxyType 0 2>/dev/null
      as_owner env HOME="$USER_HOME" "$TOOL" --file kioslaverc --group 'Proxy Settings' --key 'Proxy Config Script' '' 2>/dev/null
      kde_reparse "$bus"
      rm -f "$VARDIR/desktop-proxy.on"
      say "desktop proxy reset via $(basename "$TOOL") for $OWNER" ;;
  esac
}

proxy_stop() {
  local pids
  # a standing redirect would hit a dead port
  if [ -n "$NFT" ] && $NFT list chain inet guardrail divert 2>/dev/null | grep -q redirect; then
    say "a redirect rule stands; lifting it before the proxy stops"
    disarm || say "the rule could not be lifted; the failsafe stays armed"
  fi
  # Restart= would revive it; stop through systemd first
  if [ "$HAS_SYSTEMD" = 1 ] && systemctl is-active --quiet guardrail-proxy.service 2>/dev/null; then
    systemctl stop guardrail-proxy.service && say "guardrail-proxy.service stopped"
  fi
  # root kills only our proxy user's processes
  pids="$(cat "$PIDFILE" 2>/dev/null; pgrep -u "$PUSER" -f 'mitmdump --mode transparent' || true)"
  pids="$(printf '%s\n' $pids | sort -u | tr '\n' ' ')"
  if [ -z "${pids// /}" ]; then
    rm -f "$PIDFILE"
    desktop_proxy_off
    say "no proxy running"
    return 0
  fi
  # kill only $PUSER's processes; never a recycled pid
  local keep="" p
  for p in $pids; do
    if [ -d "/proc/$p" ] && [ "$(stat -c %U "/proc/$p" 2>/dev/null)" = "$PUSER" ]; then
      keep="$keep $p"
    else
      say "not touching pid $p: it is not $PUSER's process"
    fi
  done
  pids="${keep# }"
  if [ -z "$pids" ]; then
    rm -f "$PIDFILE"
    desktop_proxy_off
    say "no running process of $PUSER to stop"
    return 0
  fi
  kill $pids 2>/dev/null
  sleep 1
  kill -9 $pids 2>/dev/null
  rm -f "$PIDFILE"
  desktop_proxy_off
  say "proxy stopped: $pids"
}

status() {
  local rp
  need_nft
  say "== divert chain"
  $NFT list chain inet guardrail divert 2>&1
  say "== quic chain"
  $NFT list chain inet guardrail quic 2>&1
  say "== set ai4"
  $NFT list set inet guardrail ai4 2>&1 | sed -n '1,4p'
  say "== set ai6"
  $NFT list set inet guardrail ai6 2>&1 | sed -n '1,4p'
  say "== diversion"
  rp=0; rule_present || rp=$?
  case "$rp" in
    0) say "   diverting: uid $UID_TARGET tcp 443 to :$PORT, IPv4 and IPv6" ;;
    1) say "   not diverting: no complete redirect for uid $UID_TARGET to :$PORT" ;;
    *) say "   UNKNOWN: nft could not be read, so no claim is made either way" ;;
  esac
  say "== failsafe ($(failsafe_method))"
  if [ "$HAS_SYSTEMD" = 1 ]; then
    systemctl list-timers --all 'guardrail*' --no-pager 2>&1 | sed -n '1,3p'
  elif [ -f "$FSPID" ] && kill -0 "$(cat "$FSPID")" 2>/dev/null; then
    say "   background failsafe armed, pid $(cat "$FSPID")"
  else
    say "   no background failsafe armed"
  fi
  echo "== watchdog"
  if [ -n "$OWNER" ] && [ "$UID_TARGET" != 0 ] && [ -f "$RUN_APP/watchdog.py" ]; then
    as_owner python3 -I "$RUN_APP/watchdog.py" status 2>&1 | sed -n '1p'
  else echo "   not checked: owner or watchdog.py missing"; fi
  say "== proxy"
  say "   listeners IPv4:IPv6 = $(proxy_listeners), running as: $(listener_users)"
  listeners_warn
  ss -ltnp "sport = :$PORT" 2>&1 | sed -n '2p'
  say "== last records"
  # read as the file owner: symlinks must not feed root
  if puser_exists && [ -d "$STATE/data" ]; then
    as_puser tail -2 "$STATE/data/history.log" 2>&1
  elif [ -z "$APP" ] || [ -z "$OWNER" ]; then
    say "app $APP_NOTE"
  else
    as_owner tail -2 "$APP/data/history.log" 2>&1
  fi
}

failsafe_test() {
  local secs="${1:-20}"
  case "$secs" in ''|*[!0-9]*) die "bad seconds: $secs" ;; esac
  [ "$secs" -ge 5 ] && [ "$secs" -le 120 ] || die "seconds must be 5 to 120: $secs"
  proxy_up || die "REFUSED: nothing listens on port $PORT; start the proxy first: sudo $SELF proxy-start"
  redirect_target_ok || die "failsafe-test refused: no rule was installed"
  set_sync
  # failsafe first: if it fails, no rule is installed
  arm_failsafe "${secs}s"
  add_rule
  # same proof as arm: owner still reaches provider
  if ! e2e_check; then
    disarm
    die "failsafe-test stopped: the end-to-end check failed, the rule was lifted"
  fi
  say "waiting $((secs + 10))s for the failsafe"
  sleep $((secs + 10))
  if $NFT list chain inet guardrail divert | grep -q redirect; then
    say "FAILSAFE FAILED: the rule is still installed"
    # The dead-man switch failed: release the rule
    $NFT flush chain inet guardrail divert
    $NFT flush chain inet guardrail quic 2>/dev/null
    if $NFT list chain inet guardrail divert | grep -q redirect; then
      say "  and it could not be flushed, so the failsafe stays armed; release it by hand: sudo $SELF disarm"
    else
      failsafe_cancel
      say "  the rule was released and the failsafe cancelled; traffic is not diverted"
    fi
    chown_data
    return 1
  fi
  say "FAILSAFE OK: the rule removed itself"
  [ "$HAS_SYSTEMD" = 1 ] && systemctl status "$UNIT.service" --no-pager 2>&1 | sed -n '1,5p'
  chown_data
}

# the audit file to watch, in install order
audit_file() {
  local f
  for f in "$STATE/logs/audit.jsonl" "$STATE/audit.jsonl" "$APP/logs/audit.jsonl"; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  echo "$STATE/logs/audit.jsonl"
}


# owner's host first (field 4), then a public fallback
e2e_candidates() {
  local hist="$1" host
  if [ -f "$hist" ]; then
    host="$(tail -50 "$hist" 2>/dev/null | awk '{print $4}' \
            | grep -E '^[a-z0-9.-]+\.(com|id|ai|net|org)$' | sort | uniq -c | sort -rn \
            | awk 'NR == 1 {print $2}')"
    if [ -n "$host" ]; then
      printf '%s\n' "https://$host/v1/chat/completions" "https://$host/v1/messages"
    fi
  fi
  echo "https://api.openai.com/v1/models"
}

# one audit record in; prints ready, failed or unknown
e2e_atr_verdict() {
  case "$1" in
    *atr-not-ready*|*'"atr": "error"'*) echo failed ;;
    *'"atr": "loaded"'*) echo ready ;;
    *) echo unknown ;;
  esac
}

# one probe: 0 ok, 1 fail, 2 unrecorded, 3 undetermined
e2e_probe_one() {
  local url="$1" af="$2" probe="$3" sha="$4" bodyf="$5" before after code cexit new stat v
  before=0; [ -f "$af" ] && before="$(wc -l <"$af" 2>/dev/null || echo 0)"
  code="$(as_owner curl -s --noproxy '*' -o "$bodyf" -w '%{http_code}' --max-time 20 \
          -H 'content-type: application/json' -d "$probe" "$url" 2>/dev/null)"
  cexit=$?
  after=0; [ -f "$af" ] && after="$(wc -l <"$af" 2>/dev/null || echo 0)"
  case "$code" in
    000|"") say "end-to-end check FAILED for $url: the request did not complete (code $code, curl exit $cexit)"; return 1 ;;
  esac
  if grep -q 'guardrail_block' "$bodyf" 2>/dev/null; then
    say "end-to-end check FAILED for $url: our own rules refused the request (code $code)"
    return 1
  fi
  if [ "$after" -gt "$before" ]; then
    # our own record: match the probe's message hash
    new="$(tail -n "$((after - before))" "$af" 2>/dev/null | grep -F "\"prompt_sha\": \"$sha\"")"
    if [ -n "$new" ]; then
      stat="$(printf '%s\n' "$new" | tail -1 | sed -n 's/.*"action": "\([A-Z]*\)".*/\1/p')"
      v="$(e2e_atr_verdict "$(printf '%s\n' "$new" | tail -1)")"
      if [ "$v" = failed ]; then
        say "end-to-end check FAILED for $url: atr-not-ready, the attack rule set did not load${stat:+ ($stat)}"
        return 1
      fi
      case "$stat" in
        BLOCK|ERROR)
          say "end-to-end check FAILED for $url: our probe was recorded as $stat, so it was refused"
          return 1 ;;
      esac
      if [ "$v" = unknown ]; then
        return 3
      fi
      say "end-to-end check: $url answered (code $code) and the guardrail recorded our probe${stat:+ ($stat)}"
      return 0
    fi
  fi
  say "note: $url answered (code $code) but our probe was not recorded"
  return 2
}

e2e_check() {
  # 1 Oct 2026: own-rule refusal is not healthy
  command -v curl >/dev/null 2>&1 || { say "end-to-end check skipped: curl not found"; return 0; }
  local af hist url probe text sha bodyf rc t0 waited
  E2E_ATR_WAIT_S="${GUARDRAIL_E2E_ATR_WAIT_S:-30}"
  case "$E2E_ATR_WAIT_S" in ''|*[!0-9]*) E2E_ATR_WAIT_S=30 ;; esac
  # one deadline for all urls, capped at 120
  [ "$E2E_ATR_WAIT_S" -le 120 ] || E2E_ATR_WAIT_S=120
  af="$(audit_file)"
  # 1 Oct audit: $STATE/history.log empty, owner host never used
  hist="$STATE/data/history.log"
  local -a urls=()
  while IFS= read -r url; do urls+=("$url"); done < <(e2e_candidates "$hist")
  text="guardrail arm check $$-$(date +%s)"
  sha="$(printf '%s' "$text" | sha256sum | cut -c1-12)"
  probe="{\"messages\":[{\"role\":\"user\",\"content\":\"$text\"}]}"
  # the owner's curl must be able to write it
  bodyf="$(as_owner mktemp "${TMPDIR:-/tmp}/guardrail-e2e-body.XXXXXX")"
  local -a tried=()
  t0="$(date +%s)"
  for url in "${urls[@]}"; do
    while :; do
      e2e_probe_one "$url" "$af" "$probe" "$sha" "$bodyf"; rc=$?
      if [ "$rc" = 3 ]; then
        waited=$(( $(date +%s) - t0 ))
        if [ "$waited" -lt "$E2E_ATR_WAIT_S" ]; then sleep 2; continue; fi
        say "end-to-end check: rule-set state undetermined for $url after ${waited}s of waiting"
      fi
      break
    done
    if [ "$rc" = 0 ]; then
      rm -f "$bodyf"
      [ "${#tried[@]}" -gt 0 ] && say "end-to-end check passed on $url after failing: ${tried[*]}"
      return 0
    fi
    tried+=("$url=rc$rc")
  done
  rm -f "$bodyf"
  say "end-to-end check FAILED: tried ${#tried[@]} endpoints, none passed: ${tried[*]}"
  return 1
}


# Owner-run watchdog: arm starts it, disarm stops it.
watchdog_start() {
  local wd="$RUN_APP/watchdog.py" out rc
  local -a envv=(GUARDRAIL_PORT="$PORT" GUARDRAIL_REGULAR_PORT="$REGULAR_PORT")
  if [ -z "$OWNER" ] || [ "$UID_TARGET" = 0 ]; then say "WATCHDOG NOT STARTED: owner unknown"; return 0; fi
  if [ ! -f "$wd" ]; then
    say "WATCHDOG NOT STARTED: $wd is missing; run install again so the app copy carries it"; return 0
  fi
  [ -n "$APP" ] && envv+=(WATCHDOG_ROUTER_PID="$APP/data/router.pid")
  out="$(as_owner env "${envv[@]}" python3 -I "$wd" start 2>&1)"; rc=$?
  say "watchdog: ${out:-no output}"
  [ "$rc" = 0 ] || say "WATCHDOG IS NOT RUNNING (rc $rc): armed without it, only the failsafe covers the rule"
  return 0
}

# A reverting watchdog ignores this and ends itself.
watchdog_stop() {
  local wd="$RUN_APP/watchdog.py"
  { [ -n "$OWNER" ] && [ "$UID_TARGET" != 0 ] && [ -f "$wd" ]; } || return 0
  say "watchdog: $(as_owner python3 -I "$wd" stop 2>&1)"
  return 0
}

# failsafe 300..3600 s; --long lifts the top
arm_window_ok() {
  local secs
  secs="$(to_seconds "${1:-15m}")" || die "bad duration: $1"
  [ "$secs" -ge 300 ] || die "failsafe under 300s (got $1) would fire during the end-to-end check"
  if [ "$secs" -gt 3600 ] && [ "$LONG" != 1 ]; then
    die "failsafe over 3600s (got $1) needs --long, which asks for a password"
  fi
}

# Refuse before any rule when the redirect target is not served.
redirect_target_ok() {
  local l v4 v6
  l="$(proxy_listeners)"; v4="${l%%:*}"; v6="${l##*:}"
  if [ "${v4:-0}" -lt 1 ]; then
    say "REFUSED: nothing listens on 127.0.0.1:$PORT, so a redirect to it would cut your AI traffic"
    say "  start the proxy first: sudo $SELF proxy-start (guardrail-proxy.service); no rule or desktop proxy was changed"
    return 1
  fi
  if [ "${v6:-0}" -lt 1 ] && [ -e /proc/net/if_inet6 ]; then
    say "REFUSED: no IPv6 listener on [::1]:$PORT, and the IPv6 redirect would point at it"
    say "  restart the proxy: sudo $SELF proxy-stop, then proxy-start; no rule or desktop proxy was changed"
    return 1
  fi
  return 0
}

arm() {
  local users rp
  arm_window_ok "${1:-15m}"
  # arm never starts the proxy: no listener means refuse, nothing changed
  proxy_up || die "REFUSED: nothing listens on port $PORT; start the proxy first: sudo $SELF proxy-start"
  users="$(listener_users)"
  case " $users " in
    *" $PUSER "*) ;;
    *) die "port $PORT is held by '${users:-unknown}', not $PUSER; run proxy-stop, then arm again" ;;
  esac
  redirect_target_ok || die "arm refused: no rule, desktop proxy or failsafe was touched"
  # half-armed run must undo proxy setting and rules
  ARM_OK=0
  trap 'if [ "${ARM_OK:-0}" != 1 ]; then say "arm did not complete: taking the rule back"; disarm; fi' EXIT
  desktop_proxy_on
  set_sync
  # no rule without a dead-man switch: failsafe comes first
  arm_failsafe "${1:-15m}"
  # listener may have gone during set-sync or failsafe setup
  redirect_target_ok || die "arm refused: the listener went away before the rule; the exit trap undoes the rest"
  add_rule
  # a silent arm without the rule is worse than none
  rp=0; rule_present || rp=$?
  if [ "$rp" = 1 ]; then
    say "the rule was not present after arming; installing it again"
    add_rule
    rp=0; rule_present || rp=$?
  fi
  case "$rp" in
    0) ;;
    2) die "arm failed: nft cannot be read, so the rule state is unknown; the exit trap takes the rule back" ;;
    *) die "arm failed: the kernel rule is not present, so traffic would go uninspected" ;;
  esac
  chown_data
  # trap stays until e2e passes
  if ! e2e_check; then
    say "disarming again: leaving your traffic alone is better than diverted and broken"
    die "arm failed the end-to-end check; the exit trap takes the rule back"
  fi
  ARM_OK=1
  trap - EXIT
  # only an armed rule that passed e2e is worth watching
  watchdog_start
}

pin_owner() {
  install -d -o root -g root -m 0755 /etc/guardrail
  # sync unit has no sudo: owner and app pinned root-only
  if [ "$(conf_get OWNER_UID)" != "$UID_TARGET" ] || [ "$(conf_get APP)" != "$APP" ]; then
    printf 'OWNER_UID=%s\nAPP=%s\n' "$UID_TARGET" "$APP" >"$CONF"
    chmod 0644 "$CONF"
    say "owner uid $UID_TARGET and app $APP pinned in $CONF"
  fi
}

# phase 4/6 are units; no systemd means refused, not half-written
units_enable() {
  need_systemd
  [ -d "$UNITDIR" ] || die "no $UNITDIR on this host"
  [ -f "$UNITDIR/guardrail-proxy.service" ] || die "units not written yet; run install first"
  systemctl enable guardrail-proxy.service guardrail-sync.timer >/dev/null 2>&1 \
    || die "could not enable the units"
  say "units enabled: the proxy and the sync timer start at boot"
}


units_install() {
  need_systemd
  need_nft
  [ "$DEV" = 1 ] && die "units run the installed layout only; --dev is never made permanent"
  proxy_preflight
  pin_owner
  write_runner
  # never save an empty ruleset over a good one
  ensure_table
  if $NFT list table inet guardrail >"/etc/guardrail/guardrail.nft.new" 2>/dev/null \
     && [ -s "/etc/guardrail/guardrail.nft.new" ]; then
    mv "/etc/guardrail/guardrail.nft.new" "/etc/guardrail/guardrail.nft"
    say "saved ruleset: /etc/guardrail/guardrail.nft ($(wc -l <"/etc/guardrail/guardrail.nft") lines)"
  else
    rm -f "/etc/guardrail/guardrail.nft.new"
    say "WARNING: the nft table could not be saved, so guardrail-net.service has no ruleset"
  fi
  cat >"$UNITDIR/guardrail-net.service" <<EOF
[Unit]
Description=Guardrail network redirect (nftables)
After=network-online.target
[Service]
Type=oneshot
ExecStart=$NFT -f /etc/guardrail/guardrail.nft
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
EOF
  cat >"$UNITDIR/guardrail-proxy.service" <<EOF
[Unit]
Description=Guardrail transparent proxy
After=network-online.target
[Service]
User=$PUSER
Group=$(id -gn "$PUSER")
ExecStart=$RUNNER
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=$VARDIR $LOGDIR
[Install]
WantedBy=multi-user.target
EOF
  cat >"$UNITDIR/guardrail-sync.service" <<EOF
[Unit]
Description=Guardrail endpoint address sync
[Service]
Type=oneshot
ExecStart=$SELF set-sync
EOF
  cat >"$UNITDIR/guardrail-sync.timer" <<EOF
[Unit]
Description=Guardrail endpoint sync timer
[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
EOF
  user_notifier_install
  systemctl daemon-reload
  say "units written in $UNITDIR, nothing enabled yet"
}

# the block banner runs in the user session; the proxy has no bus
user_notifier_install() {
  [ -f "$IAPP/notify_user.py" ] || { say "no notify_user.py in $IAPP; no user notifier unit"; return 0; }
  install -d -o root -g root -m 0755 "$USERUNITDIR"
  cat >"$USERUNITDIR/guardrail-notify.service" <<UNIT
[Unit]
Description=Guardrail block banner (reads the audit file, raises desktop notes)
ConditionPathExists=$LOGDIR/audit.jsonl

[Service]
ExecStart=/usr/bin/python3 -I $IAPP/notify_user.py $LOGDIR/audit.jsonl
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
  chmod 0644 "$USERUNITDIR/guardrail-notify.service"
  say "user unit written: $USERUNITDIR/guardrail-notify.service (not enabled)"
  say "  the owner starts it in the desktop session with: systemctl --user enable --now guardrail-notify.service"
}

units_remove() {
  if [ "$HAS_SYSTEMD" != 1 ]; then say "no systemd here: no units to remove"; return 0; fi
  systemctl disable --now guardrail-net.service guardrail-proxy.service guardrail-sync.timer >/dev/null 2>&1
  rm -f "$UNITDIR/guardrail-net.service" "$UNITDIR/guardrail-proxy.service" \
        "$UNITDIR/guardrail-sync.service" "$UNITDIR/guardrail-sync.timer" \
        /etc/guardrail/guardrail.nft
  rm -f "$USERUNITDIR/guardrail-notify.service"
  systemctl daemon-reload
  say "units removed, /etc/guardrail left in place"
}

show_journal() {
  local u="${1:-}"
  case "$u" in guardrail*) ;; *) die "only guardrail units: $u" ;; esac
  command -v journalctl >/dev/null 2>&1 || die "no journalctl here; the helper's own record is $LOG"
  journalctl -u "$u" -n 40 --no-pager 2>&1
}

seal_logs() {
  local f
  for f in /tmp/guardrail-run.log /tmp/guardrail-router.log /tmp/guardrail-watch.md; do
    if [ -L "$f" ]; then say "not sealed, a symlink: $f"
    elif [ -f "$f" ]; then chmod 0600 "$f"; say "sealed $f"; fi
  done
}

purge_logs() {
  local f
  for f in /tmp/guardrail-*.log; do
    if [ -f "$f" ]; then rm -f "$f"; say "removed $f"; fi
  done
}

revoke() {
  # the failsafe unit runs this helper: release the rule first
  if [ -n "$NFT" ] && $NFT list table inet guardrail 2>/dev/null | grep -qE 'redirect to|udp dport 443'; then
    say "the redirect rule is still installed; releasing it before the helper goes away"
    disarm
  fi
  # the failsafe runs this helper: removing it strands the rule
  if [ -n "$NFT" ] && $NFT list table inet guardrail 2>/dev/null | grep -qE 'redirect to|udp dport 443'; then
    say "REFUSING to remove the helper: the redirect rule is still installed"
    say "  the failsafe runs $SELF, so removing it strands the rule with no way back"
    say "  release it first: sudo $SELF disarm"
    return 1
  fi
  # an enabled net unit diverts again at boot
  if [ "$HAS_SYSTEMD" = 1 ] && systemctl is-enabled --quiet guardrail-net.service 2>/dev/null; then
    say "REFUSING to remove the helper: guardrail-net.service is still enabled"
    say "  at the next boot it would load the saved ruleset, with no helper to undo it"
    say "  disable it first: sudo $SELF disarm"
    return 1
  fi
  rm -f "$SUDOERS_FILE" /etc/sudoers.d/guardrail-test && say "sudoers entry removed"
  rm -f "$HELPER_PATH" "$OLD_HELPER_PATH" && say "helper removed from /usr/local/sbin"
  say "root access released; confirm with: sudo -n -l"
}

disarm() {
  local rc=0
  # an enabled net unit would divert again at boot
  if [ "$HAS_SYSTEMD" = 1 ] && systemctl is-enabled --quiet guardrail-net.service 2>/dev/null; then
    if systemctl disable --now guardrail-net.service >/dev/null 2>&1; then
      say "guardrail-net.service disabled: it cannot divert again at boot"
    else
      say "guardrail-net.service is enabled and could not be disabled; it will divert again at boot"
    fi
  fi
  if [ -n "$NFT" ] && $NFT list chain inet guardrail divert >/dev/null 2>&1; then
    if $NFT flush chain inet guardrail divert; then say "divert chain flushed"
    else say "divert chain could NOT be flushed"; rc=1; fi
  else
    say "no divert chain to flush"
  fi
  # the quic rejects go too: revoke refuses while they stand
  if [ -n "$NFT" ] && $NFT list chain inet guardrail quic >/dev/null 2>&1; then
    if $NFT flush chain inet guardrail quic; then say "quic chain flushed"
    else say "quic chain could NOT be flushed"; rc=1; fi
  fi
  # cancel the failsafe only once the rules are gone
  if [ "$rc" = 0 ]; then failsafe_cancel; watchdog_stop
  else say "the rule may still stand, so the failsafe stays armed"; fi
  # reset desktop PAC: stale one broke browsers, 1 Oct 2026
  desktop_proxy_off
  if proxy_up; then say "proxy still listening on $PORT"; else say "proxy is not listening"; fi
  chown_data
  return "$rc"
}

