#!/usr/bin/env bash
# Root helper, sudo-only; the proxy never runs as root.
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/run/current-system/sw/bin

# --dev needed: sudo drops GR_DEV; mode is unsafe
DEV=0
LONG=0
ARGS=()
for a in "$@"; do case "$a" in --dev) DEV=1 ;; --long) LONG=1 ;; *) ARGS+=("$a") ;; esac; done
[ "${GR_DEV:-0}" = 1 ] && DEV=1
set -- "${ARGS[@]+"${ARGS[@]}"}"

# only SUDO_UID from caller; /etc/guardrail/helper.conf pins OWNER_UID, APP
CONF=/etc/guardrail/helper.conf
RECORD=/etc/guardrail/install.record
SELF="$(readlink -f "$0")"
# regular listener exists only for PAC clients using CONNECT
PORT="${GUARDRAIL_PORT:-8899}"
REGULAR_PORT="${GUARDRAIL_REGULAR_PORT:-8898}"
LOG=/var/log/guardrail-adm.log
PIDFILE=/run/guardrail-proxy.pid
FSPID=/run/guardrail-failsafe.pid
LIST=/run/guardrail-ai4.list
LIST6=/run/guardrail-ai6.list
LISTNAT=/run/guardrail-nat64.list
UNIT=guardrail-failsafe
UNITDIR=/etc/systemd/system
USERUNITDIR=/etc/systemd/user
PUSER=guardrail-proxy
# Installed layout.
LIBDIR=/usr/local/lib/guardrail
VENV=$LIBDIR/venv
IAPP=$LIBDIR/app
HFDIR=$LIBDIR/hf
RUNNER=$LIBDIR/bin/proxy-run
CA_PUB=$LIBDIR/guardrail-ca.pem
VARDIR=/var/lib/guardrail
CONFDIR=$VARDIR/conf
STATE=$VARDIR/state
PACDIR=$VARDIR/pac
LOGDIR=/var/log/guardrail
PROXY_LOG=$LOGDIR/proxy.log
# only these app files are copied to the proxy
APP_FILES="guardrail.py rules.py router.py sweep.py panel.py watchdog.py notify_user.py requirements.txt guardrail.yaml atr data/dlp"
CA_FILES="mitmproxy-ca.pem mitmproxy-ca-cert.pem mitmproxy-ca-cert.cer mitmproxy-ca-cert.p12 mitmproxy-ca.p12 mitmproxy-dhparam.pem"
NFT="$(command -v nft || true)"
HAS_SYSTEMD=0
[ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 && HAS_SYSTEMD=1

# Root-only log: created 0600, never carries history text.
log() {
  [ -w "$LOG" ] || [ "$(id -u)" -eq 0 ] || return 0
  [ -e "$LOG" ] || [ "$(id -u)" -ne 0 ] || install -m 0600 /dev/null "$LOG" 2>/dev/null
  [ -e "$LOG" ] || return 0
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
}
say() { printf '%s\n' "$*"; log "$*"; }
die() { printf 'error: %s\n' "$*" >&2; log "error: $*"; exit 1; }

# One key from a root-owned file nobody else can write.
root_file_get() {
  local f="$1" k="$2"
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  [ "$(stat -c %u "$f")" = 0 ] || return 0
  case "$(stat -c %A "$f")" in ?????w????|????????w?) return 0 ;; esac
  sed -n "s/^$k=//p" "$f"
}
conf_get() { root_file_get "$CONF" "$1" | tail -1; }

# owner = sudo caller; systemd units fall back to helper.conf
UID_TARGET=""
case "${SUDO_UID:-}" in ''|0|*[!0-9]*) ;; *) UID_TARGET="$SUDO_UID" ;; esac
[ -n "$UID_TARGET" ] || UID_TARGET="$(conf_get OWNER_UID)"
[ -n "$UID_TARGET" ] || { [ "$(id -u)" -ne 0 ] && UID_TARGET="$(id -u)"; }
OWNER=""; USER_HOME=""; OWNER_GROUP=""
if [ -n "$UID_TARGET" ]; then
  OWNER="$(getent passwd "$UID_TARGET" | cut -d: -f1)"
  USER_HOME="$(getent passwd "$UID_TARGET" | cut -d: -f6)"
  OWNER_GROUP="$(id -gn "$UID_TARGET" 2>/dev/null)"
fi

# app source to copy: pinned in helper.conf, else under home
APP="$(conf_get APP)"
APP_NOTE="from $CONF"
if [ -z "$APP" ] && [ -n "$USER_HOME" ]; then
  found="$(find "$USER_HOME" -maxdepth 5 -path "$USER_HOME/.*" -prune -o \
             -type f -path '*/llm-guardrail/guardrail.py' -print 2>/dev/null)"
  if [ "$(printf '%s' "$found" | grep -c .)" = 1 ]; then
    APP="$(dirname "$found")"; APP_NOTE="found under $USER_HOME"
  else
    APP_NOTE="not found: $(printf '%s' "$found" | grep -c .) copies of llm-guardrail/guardrail.py under $USER_HOME; pin one from the tree it sits in: sudo bash <tree>/llm-guardrail/guardrail-adm install"
  fi
fi
if [ "$DEV" = 1 ]; then RUN_APP="$APP"; MITMDUMP="$APP/.venv/bin/mitmdump"
else RUN_APP="$IAPP"; MITMDUMP="$VENV/bin/mitmdump"
fi

NO_DEPS=0
MODEL_SRC=""

need_owner() { [ -n "$OWNER" ] && [ "$UID_TARGET" != 0 ] || die "owner unknown: call through sudo, or pin OWNER_UID in $CONF"; }
need_app() { need_owner; [ -n "$APP" ] && [ -f "$APP/guardrail.py" ] || die "app $APP_NOTE"; }
need_nft() { [ -n "$NFT" ] || die "nft not found: install nftables"; }
need_systemd() { [ "$HAS_SYSTEMD" = 1 ] || die "this verb needs systemd, which is not running here; nothing was changed"; }
need_python() { command -v python3 >/dev/null 2>&1 || die "python3 not found"; }
# visudo must exist before install writes the sudoers entry
need_sudo_tool() { command -v visudo >/dev/null 2>&1 || die "visudo not found; install sudo first (e.g. apk add sudo)"; }

# run as a user: runuser, setpriv or su, whichever exists
as_user() {
  local who="$1"; shift
  # runuser can exist yet fail; try each tool once
  if command -v runuser >/dev/null 2>&1 && runuser -u "$who" -- true 2>/dev/null; then
    runuser -u "$who" -- "$@"
  elif command -v setpriv >/dev/null 2>&1 \
       && setpriv --reuid="$(id -u "$who")" --regid="$(id -g "$who")" --init-groups -- true 2>/dev/null; then
    setpriv --reuid="$(id -u "$who")" --regid="$(id -g "$who")" --init-groups -- "$@"
  elif command -v su >/dev/null 2>&1; then su -s /bin/sh "$who" -c "$(printf '%q ' "$@")"
  else return 127
  fi
}
as_owner() { as_user "$OWNER" "$@"; }
as_puser() { as_user "$PUSER" "$@"; }

# 15m, 15min, 20s, 20 -> seconds.
to_seconds() {
  local n="${1%%[a-z]*}" u="${1#"${1%%[a-z]*}"}"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  case "$u" in
    ''|s|sec) echo "$n" ;;
    m|min) echo $((n * 60)) ;;
    h) echo $((n * 3600)) ;;
    *) return 1 ;;
  esac
}

failsafe_method() {
  if [ "$HAS_SYSTEMD" = 1 ]; then echo systemd
  elif command -v setsid >/dev/null 2>&1 && command -v sleep >/dev/null 2>&1; then echo background
  else echo none
  fi
}

# owner desktop and session bus, read from their processes
owner_env() {
  local p v
  for p in /proc/[0-9]*; do
    [ "$(stat -c %u "$p" 2>/dev/null)" = "$UID_TARGET" ] || continue
    v="$(tr '\0' '\n' <"$p/environ" 2>/dev/null | sed -n "s/^$1=//p" | head -1)"
    [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  done
  return 1
}

# which tool resets the owner desktop proxy, or none
desktop_tool() {
  local d; d="$(owner_env XDG_CURRENT_DESKTOP || owner_env DESKTOP_SESSION || true)"
  d="$(printf '%s' "$d" | tr 'A-Z;' 'a-z:')"
  DESKTOP="${d:-none}"; TOOL=""; SKIP=""
  case ":$DESKTOP:" in
    *:kde:*|*:plasma*)
      TOOL="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
      [ -n "$TOOL" ] || SKIP="KDE session without kwriteconfig5/6" ;;
    *:gnome*|*:unity:*|*:budgie*|*:cinnamon:*|*:pantheon:*|*:mate:*)
      TOOL="$(command -v gsettings || true)"
      [ -n "$TOOL" ] || SKIP="$DESKTOP session without gsettings" ;;
    *:xfce*)
      if command -v gsettings >/dev/null 2>&1 && [ -n "$(owner_bus)" ] && as_owner env \
           "DBUS_SESSION_BUS_ADDRESS=$(owner_bus)" gsettings writable org.gnome.system.proxy mode >/dev/null 2>&1; then
        TOOL="$(command -v gsettings)"
      else
        SKIP="XFCE has no desktop proxy key in xfconf and the GNOME proxy schema is not usable"
      fi ;;
    :none:) SKIP="no desktop session for $OWNER" ;;
    *) SKIP="desktop '$DESKTOP' has no proxy tool this helper knows" ;;
  esac
}

owner_bus() {
  if [ -S "/run/user/$UID_TARGET/bus" ]; then printf 'unix:path=%s' "/run/user/$UID_TARGET/bus"
  else owner_env DBUS_SESSION_BUS_ADDRESS || true
  fi
}

# Owner, group and mode of one path, for refusal messages.
describe() { stat -c '%n (owner %U, group %G, mode %a)' "$1" 2>/dev/null || printf '%s (missing)' "$1"; }

# parent groups treated as root: root staff adm syslog
SYS_GROUPS="root staff adm syslog"

# path and parents root-owned; group write only above for SYS_GROUPS
chain_ok() {
  local p start mode g
  p="$(readlink -f "$1" 2>/dev/null)" || { BAD="$1 (cannot be resolved)"; return 1; }
  [ -e "$p" ] || { BAD="$1 (missing)"; return 1; }
  # "above": $1 is a parent dir, so parents' rule applies
  start="$p"; [ "${2:-}" = above ] && start=""
  while :; do
    mode="$(stat -c %a "$p")"
    if [ "$(stat -c %u "$p")" != 0 ] || [ $(( 8#$mode & 8#002 )) -ne 0 ]; then
      BAD="$(describe "$p")"; return 1
    fi
    if [ $(( 8#$mode & 8#020 )) -ne 0 ]; then
      g="$(stat -c %G "$p")"
      case " $SYS_GROUPS " in *" $g "*) [ "$p" != "$start" ] ;; *) false ;; esac \
        || { BAD="$(describe "$p"), writable by group $g"; return 1; }
    fi
    [ "$p" = / ] && return 0
    p="$(dirname "$p")"
  done
}

# Refuse copied paths linking outside the tree; tar follows links.
ensure_no_outside_links() {
  local root="$1" link p; shift
  local -a paths=()
  for p in "$@"; do paths+=("$root/$p"); done
  [ "$#" -gt 0 ] || paths=("$root")
  while IFS= read -r link; do
    case "$(readlink -f "$link")" in
      "$root"/*) ;;
      *) BAD="symlink out of the tree: $link -> $(readlink -f "$link")"; return 1 ;;
    esac
  done < <(find "${paths[@]}" -type l 2>/dev/null)
  return 0
}


# root-owned tree; links only inside it or to root's files
tree_ok() {
  local root="$1" allow_links="${2:-0}" hit l target
  chain_ok "$root" || return 1
  hit="$(find "$root" ! -type l \( ! -uid 0 -o -perm /022 \) -printf '%p (owner %u, mode %m)\n' 2>/dev/null | head -1)"
  [ -z "$hit" ] || { BAD="$hit"; return 1; }
  while IFS= read -r l; do
    target="$(readlink -f -- "$l" 2>/dev/null || true)"
    if [ -z "$target" ] || [ ! -e "$target" ]; then
      BAD="$l (symlink that leads nowhere)"; return 1
    fi
    case "$target" in
      "$root"/*) continue ;;               # a link inside the tree is fine
    esac
    # a venv may link out, but only to root-owned files
    if [ "$allow_links" != 1 ]; then
      BAD="$l -> $target (symlink inside the installed tree)"; return 1
    fi
    if [ "$(stat -c %u -- "$target" 2>/dev/null)" != 0 ]; then
      BAD="$l -> $target (symlink to a file that is not root's)"; return 1
    fi
    [ -z "$(find "$target" -maxdepth 0 -perm /022 2>/dev/null)" ] \
      || { BAD="$l -> $target (symlink to a writable file)"; return 1; }
  done < <(find "$root" -type l 2>/dev/null)
  return 0
}

# proxy dirs owned by the proxy user, parents root-only
puser_dir_ok() {
  local d="$1" mode="$2"
  chain_ok "$(dirname "$d")" above || return 1
  if [ -L "$d" ] || [ ! -d "$d" ]; then BAD="$d (missing or a symlink)"; return 1; fi
  [ "$(stat -c '%U %a' "$d")" = "$PUSER $mode" ] || { BAD="$(describe "$d"), expected owner $PUSER mode $mode"; return 1; }
}

# audit dir: proxy owns it, the owner's group reads it
audit_dir_ok() {
  local d="$LOGDIR" mode
  chain_ok "$(dirname "$d")" above || return 1
  if [ -L "$d" ] || [ ! -d "$d" ]; then BAD="$d (missing or a symlink)"; return 1; fi
  mode="$(stat -c %a "$d")"
  [ "$(stat -c '%U %G' "$d")" = "$PUSER $OWNER_GROUP" ] \
    || { BAD="$(describe "$d"), expected owner $PUSER group $OWNER_GROUP"; return 1; }
  # setgid so new files inherit the group; nothing for others
  [ "$mode" = 2750 ] || { BAD="$(describe "$d"), expected mode 2750"; return 1; }
}

puser_exists() { id -u "$PUSER" >/dev/null 2>&1; }

detect() {
  local fs
  desktop_tool
  fs="$(failsafe_method)"
  echo "owner      : ${OWNER:-unknown} uid ${UID_TARGET:-?}"
  echo "app        : ${APP:-none} ($APP_NOTE)"
  echo "mode       : $([ "$DEV" = 1 ] && echo 'DEV (project tree runs as the proxy user, not safe)' || echo 'installed layout')"
  echo "proxy user : $PUSER $(puser_exists && id "$PUSER" || echo '(missing)')"
  echo "venv       : $VENV $([ -x "$VENV/bin/mitmdump" ] && echo present || echo missing)"
  echo "app copy   : $IAPP $([ -f "$IAPP/guardrail.py" ] && echo present || echo missing)"
  echo "previous app: $IAPP.prev $([ -f "$IAPP.prev/guardrail.py" ] && echo kept || echo none)"
  echo "nft        : ${NFT:-NOT FOUND}"
  echo "systemd    : $([ "$HAS_SYSTEMD" = 1 ] && echo running || echo 'not running or no systemctl')"
  echo "failsafe   : $fs"
  [ "$fs" = none ] && echo "             arm would refuse: no way to remove the rule on its own"
  echo "desktop    : $DESKTOP -> ${TOOL:-skip: $SKIP}"
  echo "session bus: $(owner_bus)"
  echo "run as user: $(command -v runuser || command -v setpriv || command -v su || echo none)"
}

usage() {
  cat <<EOF
guardrail-adm <verb> [args] [--dev]
  install [opts]         one-command install: proxy user, root venv, app copy, CA, trust, units,
                         rule with failsafe, then verify. opts: --with-model [--model-src=DIR] --persist --failsafe=15m
                         --arm also diverts traffic now (default: install only, arm later)
                         --dry-run prints the plan for this device and changes nothing
                         run from the project tree this also writes the helper, its sudoers entry
                         and helper.conf first, then hands over to the installed copy
  uninstall              undo install: rule, units, trust, NSS, env file, files, proxy user
  requirements [--install]   check the prerequisite tools; install the missing ones
  verify                 print and check user, venv, path owners, CA fingerprints, listeners, rule, timers
  status                 who is listening, the rule, the timer, the last records
  set-sync               refresh sets ai4/ai6 from the router findings and the proxy's own cache
  endpoints [host...]    print the effective endpoint list, sources and absent hosts (read-only)
  mode <neutral|persistent>  write the strictness the installed proxy reads ($STATE/mode)
  proxy-start [user]     start the transparent proxy as $PUSER ('root' is accepted, never used)
  proxy-stop             stop it again
  arm [duration]         set + rule (proxy must already listen), with a failsafe that flushes it, then the watchdog
                         failsafe 300s to 3600s; longer needs --long and a password
  disarm                 flush the rule, then stop the failsafe timer and the watchdog
  failsafe-test [secs]   prove the dead-man switch fires, then leave the rule off
  units-install          write the systemd units for the installed layout (nothing enabled)
  units-enable           let those units start at boot (off by default at install)
  units-remove           remove them again
  user-add               create the $PUSER system user
  journal <unit>         last journal lines of one guardrail unit
  seal-logs              chmod 0600 the proxy logs that hold request headers
  purge-logs             delete the proxy logs left in /tmp by earlier runs
  revoke                 remove the sudoers entry and this helper, ending root access
  rollback               put the previous app copy back and drop the rule; uninstall (log kept) when none
  ca-status              where the CA is and which stores trust it (read-only)
  ca-trust               put the CA into the system, browser and runtime stores again
  ca-untrust             take it out of them again; the install stays
  detect                 what this host offers (read-only, also works without root)
  --dev                  run the project tree instead of the installed copy. NOT SAFE: whoever can
                         write the project tree controls the proxy and its CA key. Never the default.
EOF
}

# Prerequisites live here, never in a file the caller names.
requirements_lines() {
  cat <<'REQ'
bash|command:bash|bash|bash|bash|bash|bash
python3|command:python3|python3|python3|python3|python3|python
venv|module:ensurepip|python3|python3-venv|python3|python3|python
pip|run:python3 -m pip --version|py3-pip|python3-pip|python3-pip|python3-pip|python-pip
openssl|command:openssl|openssl|openssl|openssl|openssl|openssl
curl|command:curl|curl|curl|curl|curl|curl
nft|command:nft|nftables|nftables|nftables|nftables|nftables
sudo|command:sudo|sudo|sudo|sudo|sudo|sudo
ss|command:ss|iproute2|iproute2|iproute|iproute2|iproute2
pgrep|command:pgrep|procps|procps|procps-ng|procps|procps-ng
REQ
}

# Optional rows: missing never stops an install.
requirements_optional_lines() {
  cat <<'REQ'
notify-send|command:notify-send|libnotify|libnotify-bin|libnotify|libnotify-tools|libnotify
REQ
}

# Column of the family inside a requirement row.
req_columns() {
  case "$1" in
    alpine) echo 3 ;;
    debian) echo 4 ;;
    fedora) echo 5 ;;
    suse)   echo 6 ;;
    arch)   echo 7 ;;
    *)      echo "" ;;
  esac
}

# One check: command, python module, or command exits 0.
req_ok() {
  local probe="${1#*:}"
  case "$1" in
    command:*) command -v "$probe" >/dev/null 2>&1 ;;
    # a module name is checked, never pasted
    module:*)  case "$probe" in
                 *[!A-Za-z0-9_.]*|"") return 1 ;;
                 *) python3 -I -c "import $probe" >/dev/null 2>&1 ;;
               esac ;;
    # one known shape, compared literally
    run:*)     [ "$probe" = "python3 -m pip --version" ] && python3 -I -m pip --version >/dev/null 2>&1 ;;
    *)         return 0 ;;
  esac
}

# Every requirement that is not satisfied yet, as "name package".
requirements_missing() {
  local line name check pkg col src=requirements_lines
  [ "${1:-}" = optional ] && src=requirements_optional_lines
  col="$(req_columns "$(host_family)")"
  while IFS= read -r line; do
    name="$(printf '%s' "$line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/,"",$1); print $1}')"
    check="$(printf '%s' "$line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/,"",$2); print $2}')"
    [ -n "$name" ] || continue
    req_ok "$check" && continue
    pkg=""
    [ -n "$col" ] && pkg="$(printf '%s' "$line" | awk -F'|' -v c="$col" '{gsub(/[[:space:]]/,"",$c); print $c}')"
    printf '%s %s\n' "$name" "${pkg:-$name}"
  done < <("$src")
}

requirements_report() {
  local missing opt cmd
  missing="$(requirements_missing)"
  opt="$(requirements_missing optional)"
  if [ -n "$opt" ]; then
    cmd="$(pkg_command "$(host_family)")"
    say "optional tool missing: $(printf '%s' "$opt" | awk '{print $1}' | tr '\n' ' ')- desktop banners will not show${cmd:+; install: sudo $cmd $(printf '%s' "$opt" | awk '{print $2}' | tr '\n' ' ')}"
  fi
  if [ -z "$missing" ]; then
    say "prerequisites complete on $(host_family)"
    return 0
  fi
  say "prerequisites missing: $(printf '%s' "$missing" | awk '{print $1}' | tr '\n' ' ')"
  return 1
}

# Install what the file says is missing, per family.
requirements_install() {
  local family pkgs cmd missing
  family="$(host_family)"
  [ -n "$family" ] || { say "distro family not recognised; install these yourself: $(requirements_lines | awk -F'|' '{gsub(/[[:space:]]/,"",$1); printf "%s ", $1}')"; return 1; }
  missing="$(requirements_missing)"
  [ -n "$missing" ] || return 0
# live CD repos install nothing: repoint Alpine first
  if [ "$family" = alpine ] && ! grep -qE "^https?://" /etc/apk/repositories 2>/dev/null; then
    local rel; rel="$(cut -d. -f1,2 /etc/alpine-release 2>/dev/null)"
    if [ -n "$rel" ]; then
      say "the apk repositories do not point at a network mirror yet; writing the official mirror for v$rel"
      printf 'https://dl-cdn.alpinelinux.org/alpine/v%s/main\nhttps://dl-cdn.alpinelinux.org/alpine/v%s/community\n' "$rel" "$rel" >/etc/apk/repositories
      apk update >/dev/null 2>&1
    fi
  fi
  # the column comes from the owner's file: plain names only
  pkgs="$(printf '%s' "$missing" | awk '{print $2}' \
          | grep -xE '[A-Za-z0-9][A-Za-z0-9+_-]*(\.[A-Za-z0-9][A-Za-z0-9+_-]*)*' \
          | grep -viE '\.(rpm|deb|apk|pkg\.tar)' | sort -u | tr '\n' ' ')"
  [ -n "$pkgs" ] || { say "nothing installable in that list; check the prerequisite table"; return 1; }
  cmd="$(pkg_command "$family")"
  say "installing: $cmd $pkgs"
  if ( cd / && $cmd $pkgs ) >/dev/null 2>&1; then
    say "prerequisites installed"
  else
    say "installing the prerequisites FAILED. Run it yourself and retry: sudo $cmd $pkgs"
    return 1
  fi
  return 0
}

pkg_command() {
  case "$1" in
    alpine)  echo "apk add --no-cache" ;;
    debian)  echo "env DEBIAN_FRONTEND=noninteractive apt-get install -y" ;;
    fedora)  echo "dnf install -y" ;;
    suse)    echo "zypper --non-interactive install -y" ;;
    arch)    echo "pacman -Sy --noconfirm" ;;
    *)       echo "" ;;
  esac
}

# Distro family: os-release first, else whichever package manager is present.
host_family() {
  local family="" b
  if [ -r /etc/os-release ]; then
    . /etc/os-release 2>/dev/null || true
    case "${ID:-}${ID_LIKE:-}" in
      *alpine*) family=alpine ;;
      *debian*|*ubuntu*) family=debian ;;
      *fedora*|*rhel*) family=fedora ;;
      *suse*) family=suse ;;
      *arch*) family=arch ;;
    esac
  fi
  if [ -z "$family" ]; then
    for b in apk apt-get dnf zypper pacman; do
      command -v "$b" >/dev/null 2>&1 || continue
      case "$b" in
        apk) family=alpine ;; apt-get) family=debian ;; dnf) family=fedora ;;
        zypper) family=suse ;; pacman) family=arch ;;
      esac
      break
    done
  fi
  printf '%s' "$family"
}

# Prerequisites live in the table below; install what is missing.

# One family's package list, from the file column.
deps_for_family() {
  local col; col="$(req_columns "$1")"
  [ -n "$col" ] || return 0
  requirements_lines | awk -F'|' -v c="$col" '{gsub(/[[:space:]]/,"",$c); printf "%s ", $c}'
}

# Read-only prerequisite check: allowed without root; --install needs it.
if [ "${1:-}" = requirements ] && [ "${2:-}" != --install ]; then requirements_report; exit $?; fi
if [ "${1:-}" = detect ]; then detect; exit 0; fi
case "${1:-}" in ''|-h|--help|help) usage; exit 2 ;; esac
# install --dry-run prints the plan, allowed without root
case " $* " in *" --dry-run "*) DRY_OK=1 ;; *) DRY_OK=0 ;; esac
if [ "$(id -u)" -ne 0 ] && [ "$DRY_OK" != 1 ]; then die "root only: sudo $0 ${1:-}"; fi

# tree install: write helper, sudoers, conf, then hand over
HELPER_PATH=/usr/local/sbin/guardrail-adm
SUDOERS_FILE=/etc/sudoers.d/guardrail
# keep PASSWD entries last: sudo takes the last match
sudoers_text() {
  cat <<'POLICY'
# One root entry point, and a narrow list without a password.
#
# Why the list is narrow: a process running as the owner can ask sudo to do
# anything in this file. If install, uninstall, units-install, rollback or revoke
# or any call carrying --dev ran without a password, that process could
# put its own code into the installed layout, and the installed code runs as the
# proxy user, which holds the CA key. So those stay behind a password.
#
# Only verbs that act on the root-owned installed layout run without a password,
# and each one nails the script path so no other program can be substituted.
#
# Installed and validated by: visudo -c -f /etc/sudoers.d/guardrail
# Undo: rm /etc/sudoers.d/guardrail
# sudo-rs allows only a lone trailing *; last match wins.
OWNER ALL=(root) PASSWD: /usr/local/sbin/guardrail-adm install, \
    /usr/local/sbin/guardrail-adm install *, \
    /usr/local/sbin/guardrail-adm uninstall, \
    /usr/local/sbin/guardrail-adm uninstall *, \
    /usr/local/sbin/guardrail-adm units-install, \
    /usr/local/sbin/guardrail-adm units-install *, \
    /usr/local/sbin/guardrail-adm rollback, \
    /usr/local/sbin/guardrail-adm rollback *, \
    /usr/local/sbin/guardrail-adm ca-trust, \
    /usr/local/sbin/guardrail-adm ca-trust *, \
    /usr/local/sbin/guardrail-adm ca-untrust, \
    /usr/local/sbin/guardrail-adm ca-untrust *, \
    /usr/local/sbin/guardrail-adm revoke, \
    /usr/local/sbin/guardrail-adm revoke *, \
    /usr/local/sbin/guardrail-adm arm *, \
    /usr/local/sbin/guardrail-adm proxy-start *, \
    /usr/local/sbin/guardrail-adm failsafe-test *, \
    /usr/local/sbin/guardrail-adm endpoints *, \
    /usr/local/sbin/guardrail-adm mode *
# Passwordless: exact arguments only; anything else asks or is denied.
OWNER ALL=(root) NOPASSWD: /usr/local/sbin/guardrail-adm status, \
    /usr/local/sbin/guardrail-adm detect, \
    /usr/local/sbin/guardrail-adm ca-status, \
    /usr/local/sbin/guardrail-adm verify, \
    /usr/local/sbin/guardrail-adm proxy-start, \
    /usr/local/sbin/guardrail-adm proxy-stop, \
    /usr/local/sbin/guardrail-adm arm, \
    /usr/local/sbin/guardrail-adm arm 5m, \
    /usr/local/sbin/guardrail-adm arm 10m, \
    /usr/local/sbin/guardrail-adm arm 15m, \
    /usr/local/sbin/guardrail-adm arm 30m, \
    /usr/local/sbin/guardrail-adm arm 45m, \
    /usr/local/sbin/guardrail-adm arm 60m, \
    /usr/local/sbin/guardrail-adm arm 1h, \
    /usr/local/sbin/guardrail-adm disarm, \
    /usr/local/sbin/guardrail-adm failsafe-fire, \
    /usr/local/sbin/guardrail-adm failsafe-test, \
    /usr/local/sbin/guardrail-adm set-sync, \
    /usr/local/sbin/guardrail-adm endpoints, \
    /usr/local/sbin/guardrail-adm mode neutral, \
    /usr/local/sbin/guardrail-adm mode persistent, \
    /usr/local/sbin/guardrail-adm purge-logs
POLICY
}
# old helper name; install and revoke remove it
OLD_HELPER_PATH=/usr/local/sbin/guardrail-root
self_install() {
  local a helper_only=0 uid name here app tmp
  local -a rest=()
  for a in "$@"; do
    case "$a" in --helper-only) helper_only=1 ;; *) rest+=("$a") ;; esac
  done
  uid="${SUDO_UID:-${PKEXEC_UID:-}}"
  case "$uid" in ''|0|*[!0-9]*) die "run through sudo or pkexec from the owner's account" ;; esac
  name="$(getent passwd "$uid" | cut -d: -f1)"
  [ -n "$name" ] || die "no account with uid $uid"
  here="$(cd "$(dirname "$SELF")" && pwd)"
  app="$here"
  # app may sit in a sibling folder: old layout fallback
  [ -f "$app/guardrail.py" ] || app="$(dirname "$here")/llm-guardrail"
  [ -f "$app/guardrail.py" ] || die "no app at $app; nothing was installed"
  need_sudo_tool
  install -d -o root -g root -m 0755 /usr/local/sbin
  install -o root -g root -m 0755 "$SELF" "$HELPER_PATH"
  install -d -o root -g root -m 0755 /etc/guardrail
  printf 'OWNER_UID=%s\nAPP=%s\n' "$uid" "$app" >"$CONF"
  chmod 0644 "$CONF"
  tmp="$(mktemp)"
  sudoers_text | sed "s/^OWNER /$name /" >"$tmp"
  if visudo -c -f "$tmp" >/dev/null; then
    install -o root -g root -m 0440 "$tmp" "$SUDOERS_FILE"
    say "installed for $name (uid $uid), app $app"
  else
    rm -f "$tmp"
    die "the generated sudoers entry did not validate; helper installed, sudoers not"
  fi
  rm -f "$tmp"
  # drop the older /etc/sudoers.d/guardrail-test entry, or it lingers
  if [ -e /etc/sudoers.d/guardrail-test ]; then
    rm -f /etc/sudoers.d/guardrail-test && say "removed the older /etc/sudoers.d/guardrail-test"
  fi
  # remove the old guardrail-root copy; nothing updates it
  if [ -e "$OLD_HELPER_PATH" ]; then
    rm -f "$OLD_HELPER_PATH" && say "removed the older helper at $OLD_HELPER_PATH"
  fi
  [ "$helper_only" = 1 ] && exit 0
  exec env SUDO_UID="$uid" SUDO_USER="$name" "$HELPER_PATH" install ${rest[@]+"${rest[@]}"}
}
