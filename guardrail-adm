# sha256 of the first PEM cert on stdin, colon separated
cert_fp() {
  python3 -I -c '
import hashlib, re, ssl, sys
m = re.search(r"-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----", sys.stdin.read(), re.S)
if m:
    h = hashlib.sha256(ssl.PEM_cert_to_DER_cert(m.group(0))).hexdigest().upper()
    print(":".join(h[i:i + 2] for i in range(0, len(h), 2)))'
}

record_add() { printf '%s=%s\n' "$1" "$2" >>"$RECORD.new"; }
rec_get() { { root_file_get "$RECORD" "$1"; root_file_get "$RECORD.new" "$1"; } | awk '!seen[$0]++'; }

# load the plan from rules.py after the copy passes checks
load_plan() {
  tree_ok "$IAPP" || die "refusing to run rules.py as root: $BAD"
  local out
  out="$(SUDO_UID="$UID_TARGET" python3 -I "$IAPP/rules.py" plan)" || die "rules.py plan failed"
  eval "$out"
  say "host: $GR_DISTRO_NAME (id $GR_DISTRO_ID${GR_DISTRO_LIKE:+, like $GR_DISTRO_LIKE}), pid 1 $GR_INIT"
}

# restrict the owner's CA key copy to them only
tighten_owner_ca() {
  # owner's CA private key stays, readable only by them
  local dir="$USER_HOME/.mitmproxy"
  [ -d "$dir" ] || return 0
  # no symlink: it could aim root at the wrong dir
  [ -L "$dir" ] && { say "owner-side CA directory is a symlink; left alone: $dir"; return 0; }
  # files are the owner's, so the owner tightens them
  as_owner chmod 0700 "$dir" 2>/dev/null
  for f in mitmproxy-ca.pem mitmproxy-ca.p12; do
    [ -f "$dir/$f" ] && as_owner chmod 0600 "$dir/$f" 2>/dev/null
  done
  say "owner-side CA key directory restricted: $dir (0700), key file 0600"
}

# per-family packages; --no-deps skips installing them
install_deps() {
  local family dry="${1:-0}"
  family="$(host_family)"
  if [ -z "$family" ]; then
    say "distro family not recognised; install these yourself: $(requirements_lines | awk -F'|' '{gsub(/[[:space:]]/,"",$1); printf "%s ", $1}')"
    return 0
  fi
  # --dry-run only reports: a plan installs nothing
  if [ "$dry" = 1 ]; then
    requirements_report || say "  a real install would install the missing ones first"
    return 0
  fi
  if requirements_report; then
    return 0
  fi
  if [ "$NO_DEPS" = 1 ]; then
    say "not installing (--no-deps): install the missing ones yourself and retry"
    return 0
  fi
  requirements_install || return 1
  # installed but still absent: say so, do not continue
  if ! requirements_report; then
    say "prerequisites are still missing after installing; fix them, then run install again"
    return 1
  fi
  if ldd --version 2>&1 | head -1 | grep -qi musl; then
    say "note: this system uses musl, while the mitmproxy packages are built for glibc;"
    say "      pip may have to build from source, which is slow and can fail"
  fi
}

copy_app() {
  local stage f have=() before after
  before="$(app_digest)"
  for f in $APP_FILES; do as_owner test -e "$APP/$f" && have+=("$f"); done
  [ -f "$APP/guardrail.py" ] && printf '%s\n' "${have[@]}" | grep -qx guardrail.py || die "no guardrail.py in $APP"
  install -d -o root -g root -m 0755 "$LIBDIR"
  stage="$(mktemp -d "$LIBDIR/.app.XXXXXX")" || die "mktemp failed"
  # only the copied entries; .venv is never copied
  ensure_no_outside_links "$APP" "${have[@]}" || { rm -rf "$stage"; die "$BAD"; }
  # pipefail: a failed owner read is not an empty copy
  if ! (set -o pipefail; as_owner tar -C "$APP" -chf - --exclude=__pycache__ "${have[@]}" \
       | tar -C "$stage" --no-same-owner --no-same-permissions -xf -); then
    rm -rf "$stage"; die "copying $APP failed"
  fi
  for f in "${have[@]}"; do
    [ -e "$stage/$f" ] || { rm -rf "$stage"; die "copy lost $f; installed app left as it was"; }
  done
  cmp -s "$APP/guardrail.py" "$stage/guardrail.py" \
    || { rm -rf "$stage"; die "copied guardrail.py differs from $APP/guardrail.py"; }
  chown -hR root:root "$stage"
  chmod -R u=rwX,go=rX "$stage"
  chmod 0755 "$stage"
  # a live listener never serves files being replaced
  if [ "$(app_digest "$stage")" != "$before" ] && proxy_up; then
    say "app changed: the proxy is DOWN from now until it is started again; with an armed rule your AI access is cut meanwhile"
    say "  if install stops early, recover with: sudo $SELF proxy-start"
    proxy_stop
  fi
  rm -rf "$IAPP.old"
  [ -d "$IAPP" ] && mv "$IAPP" "$IAPP.old"
  mv "$stage" "$IAPP"
  if ! tree_ok "$IAPP"; then
    rm -rf "$IAPP"; [ -d "$IAPP.old" ] && mv "$IAPP.old" "$IAPP"
    die "the app copy failed its own check: $BAD; the previous app is back; recover with: sudo $SELF proxy-start"
  fi
  after="$(app_digest)"
  [ "$before" = "$after" ] && APP_CHANGED=0 || APP_CHANGED=1
  # rollback returns to this copy
  if [ "$APP_CHANGED" = 1 ] && [ -d "$IAPP.old" ]; then
    rm -rf "$IAPP.prev"; mv "$IAPP.old" "$IAPP.prev"
  fi
  rm -rf "$IAPP.old"
  say "app copied to $IAPP (${have[*]})$([ "$APP_CHANGED" = 1 ] && echo ', changed' || echo ', unchanged')"
}

app_digest() { local d="${1:-$IAPP}"; [ -d "$d" ] && (cd "$d" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum) 2>/dev/null; }

# all pins present in $VENV; only after tree_ok passed
venv_has() {
  [ -x "$VENV/bin/python" ] && [ -x "$VENV/bin/mitmdump" ] || return 1
  "$VENV/bin/python" -I - "$@" <<'PY'
import importlib.metadata as m, sys
for pin in sys.argv[1:]:
    name, _, ver = pin.partition("==")
    try:
        have = m.version(name)
    except m.PackageNotFoundError:
        sys.exit(1)                       # a missing package is missing, version or not
    if ver and have != ver:
        sys.exit(1)
PY
}

# root venv mirrors the project pins, wheels only
build_venv() {
  local with_model="$1" py out pins=() p keep_old
  out="$(as_owner python3 -I "$IAPP/rules.py" venv-pins "$APP" ${with_model:+--with-model})" \
    || die "cannot read the package versions of $APP/.venv"
  GR_PINS=(); GR_PIN_MISSING=(); GR_PIN_PYTHON=""
  eval "$out"
  for p in "${GR_PINS[@]}"; do
    [[ "$p" =~ ^[A-Za-z0-9._-]+(==[A-Za-z0-9.+!_-]+)?$ ]] || die "odd package pin from the project venv: $p"
    pins+=("$p")
  done
  printf '%s\n' "${pins[@]}" | grep -q '^mitmproxy\(==\|$\)' || die "no mitmproxy in $APP/.venv; cannot tell which version to install"
  [ "${#GR_PIN_MISSING[@]}" -eq 0 ] || say "note: not in the project venv, so not installed: ${GR_PIN_MISSING[*]}"
  # same python minor as the project venv, if present
  if [ -n "$GR_PIN_PYTHON" ]; then py="$(command -v "python${GR_PIN_PYTHON%.*}" || command -v python3)"
  else py="$(command -v python3)"; fi
  # existing venv runs as root only after tree_ok passes
  keep_old=1
  # arg 1: venv python links out; bare check always failed
  if [ -d "$VENV" ] && ! tree_ok "$VENV" 1; then
    say "existing $VENV fails the check ($BAD); it is rebuilt, not reused"
    keep_old=0
  elif [ -d "$VENV" ] && venv_has "${pins[@]}"; then
    say "venv $VENV already has ${pins[*]}"; VENV_CHANGED=0; return 0
  fi
  say "building $VENV with $py: ${pins[*]}"
  rm -rf "$VENV.old"
  if [ -d "$VENV" ]; then
    if [ "$keep_old" = 1 ]; then mv "$VENV" "$VENV.old"; else rm -rf "$VENV"; fi
  fi
  # built in place: venv hardcodes its own path
  if ! "$py" -I -m venv "$VENV"; then
    rm -rf "$VENV"; [ -d "$VENV.old" ] && mv "$VENV.old" "$VENV"
    die "$py -m venv failed (is the venv module of $py installed?); nothing was switched"
  fi
  # tested versions as constraints; each line checked like a pin
  local cons pipdir line extra=()
  pipdir="$(mktemp -d /var/tmp/guardrail-pip.XXXXXX)" || die "cannot make a pip staging dir under /var/tmp"
  cons="$pipdir/constraints.txt"; : >"$cons"
  while IFS= read -r line; do
    [[ "$line" =~ ^[A-Za-z0-9._-]+==[A-Za-z0-9.+!_-]+$ ]] && printf '%s\n' "$line" >>"$cons"
  done < <(as_owner cat "$APP/constraints.txt" 2>/dev/null)
  # CPU-only torch wheel: the default one drags in ~3 GB of CUDA
  printf '%s\n' "${pins[@]}" | grep -q '^gliner\(==\|$\)' && extra=(--extra-index-url https://download.pytorch.org/whl/cpu)
  say "pip: $(wc -l <"$cons") constrained versions; staging in $pipdir (disk, not tmpfs)"
  # no config, no cache, no sdist: nothing untrusted as root
  if ! env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root PIP_CONFIG_FILE=/dev/null TMPDIR="$pipdir" \
       "$VENV/bin/python" -I -m pip install --isolated --no-cache-dir --disable-pip-version-check \
       --no-input --only-binary=:all: -c "$cons" ${extra[@]+"${extra[@]}"} "${pins[@]}"; then
    rm -rf "$pipdir" "$VENV"; [ -d "$VENV.old" ] && mv "$VENV.old" "$VENV"
    die "pip could not install ${pins[*]} (no network, or no wheel for this platform).
  Nothing was switched: $([ -d "$VENV" ] && echo "the previous $VENV is back in place" || echo "no venv is installed").
  The project venv is never used instead. Retry when online, or undo with: guardrail-adm uninstall"
  fi
  rm -rf "$pipdir" "$VENV.old"
  chown -hR root:root "$VENV"
  chmod -R go-w "$VENV"
  tree_ok "$VENV" 1 || die "the venv failed its own check: $BAD"
  VENV_CHANGED=1
  say "venv ready: $("$VENV/bin/python" -I -c 'import importlib.metadata as m; print("mitmproxy", m.version("mitmproxy"))')"
}

